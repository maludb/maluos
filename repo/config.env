# Shared configuration for the MaluOS package repository.
# Sourced by repo/*.sh, scripts/*.sh and tests/*.sh.

# Public base URL of the published repository (what clients put in APT sources).
MALUOS_APT_URL="${MALUOS_APT_URL:-https://apt.maluos.com}"

# Ubuntu release MaluOS is derived from.
MALUOS_SUITE="${MALUOS_SUITE:-resolute}"
MALUOS_COMPONENT="${MALUOS_COMPONENT:-main}"

# aptly local repo name.
MALUOS_APTLY_REPO="${MALUOS_APTLY_REPO:-maluos-${MALUOS_SUITE}}"

# Signing key identity. The private key lives in the maintainer's GnuPG
# keyring; only the public half is committed (packages/maluos-keyring/keys/).
MALUOS_SIGNING_UID="${MALUOS_SIGNING_UID:-MaluOS Archive Automatic Signing Key <apt@maludb.org>}"

# Production key: signs the PUBLIC tree (repo/publish.sh --public -> <publish root>/public,
# mirrored by repo/publish-remote.sh) and release checksums. Passphrase-protected, so
# only a person runs those; unattended builds use the development key above.
MALUOS_PUBLIC_SIGNING_UID="${MALUOS_PUBLIC_SIGNING_UID:-MaluOS Archive Signing Key (2026) <apt@maluos.com>}"
MALUOS_PUBLIC_PREFIX="${MALUOS_PUBLIC_PREFIX:-public}"

# Where aptly publishes (served by repo/serve.sh). Resolved against the
# invoking user's home even under sudo (image builds run as root).
MALUOS_HOME=$(getent passwd "${SUDO_USER:-$(id -un)}" | cut -d: -f6)
MALUOS_PUBLISH_ROOT="${MALUOS_PUBLISH_ROOT:-$MALUOS_HOME/.aptly/public}"
MALUOS_SERVE_PORT="${MALUOS_SERVE_PORT:-8080}"
