def log(msg):
    print(f"maluos-desktop-session: {msg}", file=sys.stderr, flush=True)


# ---------------------------------------------------------------- HTTP over a Unix socket
class _UnixConn(http.client.HTTPConnection):
    def __init__(self, path, timeout=8):
        super().__init__("maluos", timeout=timeout); self.path = path

    def connect(self):
        s = socket.socket(socket.AF_UNIX, socket.SOCK_STREAM); s.settimeout(self.timeout); s.connect(self.path); self.sock = s


def get(sock, path, query=None):
    """GET a JSON document from a MaluOS daemon socket; (status, body) or raises OSError."""
    if query:
        path += "?" + urllib.parse.urlencode({k: v for k, v in query.items() if v not in (None, "")})
    c = _UnixConn(sock)
    try:
        c.request("GET", path, headers={"Accept": "application/json"})
        r = c.getresponse(); raw = r.read()
    finally:
        c.close()
    try:
        return r.status, (json.loads(raw) if raw else {})
    except ValueError:
        return r.status, {}


def post(sock, path, body=None):
    """POST JSON to a MaluOS daemon socket; (status, body)."""
    data = json.dumps(body or {}).encode()
    c = _UnixConn(sock)
    try:
        c.request("POST", path, body=data, headers={"Content-Type": "application/json", "Accept": "application/json"})
        r = c.getresponse(); raw = r.read()
    finally:
        c.close()
    try:
        return r.status, (json.loads(raw) if raw else {})
    except ValueError:
        return r.status, {}


def ok(sock, path, query=None, default=None):
    try:
        st, body = get(sock, path, query)
        return body if st < 400 else default
    except (OSError, http.client.HTTPException):
        return default


# ---------------------------------------------------------------- the state
def os_release():
    d = {}
    try:
        for line in open("/etc/os-release"):
            if "=" in line:
                k, v = line.rstrip("\n").split("=", 1); d[k] = v.strip('"')
    except OSError:
        pass
    return d


def gpu_state():
    """The GPUs of this host and the chassis rule, by the same reader as `maluctl gpu status` (Phase 13 G1)."""
    try:
        sys.path.insert(0, "/usr/lib/maluos")
        import maluos_gpu
        st = maluos_gpu.status()
        return st["gpus"], st["chassis"], st["contribution_rule"]
    except Exception as e:
        log(f"gpu: {e.__class__.__name__}: {str(e)[:120]}")
        return [], "unknown", "opt-in"


def host_state():
    osr = os_release()
    gpus, chassis, rule = gpu_state()
    h = {"hostname": socket.gethostname(), "pretty_name": osr.get("PRETTY_NAME", "MaluOS"), "variant": osr.get("VARIANT", ""),
         "user": pwd.getpwuid(os.getuid()).pw_name, "memory": None, "gpus": gpus, "chassis": chassis, "contribution_rule": rule}
    try:
        with open(PROVISIONED) as f:
            p = json.load(f)
        h["memory"] = {"tenant": p.get("tenant"), "database": p.get("database"), "listener": p.get("listener"),
                       "components": p.get("components"), "where": "local"}
    except (OSError, ValueError):
        pass
    return h


def gateway_state():
    g = {"available": os.path.exists(GW), "ok": False}
    if not g["available"]:
        return g, None
    health = ok(GW, "/v1/maluos/health")
    if health is None:
        return g, None
    status = ok(GW, "/v1/maluos/status", default={})
    backends = []
    for b in status.get("backends") or []:
        backends.append({"name": b.get("name"), "kind": b.get("kind"), "healthy": bool(b.get("healthy")),
                         "cloud": b.get("kind") not in (None, "ollama_local", "mock"), "enabled": b.get("enabled", True),
                         "error": b.get("error"), "loaded": [m.get("name") for m in b.get("loaded") or []]})
    if not backends:
        backends = [{"name": n, "healthy": bool(h), "kind": None, "cloud": False, "enabled": True} for n, h in (health.get("backends") or {}).items()]
    g.update({"ok": bool(health.get("ok")), "version": status.get("version") or health.get("version"), "uptime_s": status.get("uptime_s"),
              "backends": backends, "queue": status.get("queue") or {"queued": 0, "running": 0},
              "expected_wait_s": status.get("expected_wait_s") or {}, "tiers": (status.get("catalog") or {}).get("tiers") or {},
              "share": status.get("share")})
    me = ok(GW, "/v1/maluos/whoami")
    return g, me


def node_state(gw_available, me):
    """The node API's view of this gateway (Phase 13 G5): this node, its lanes, the nodes it is paired with
    (remote backends) and the keys it issued. Read as the session user, so only an operator of the gateway
    sees it; anyone else gets {"available": …, "operator": False} and the tabs say so."""
    n = {"available": False, "operator": bool((me or {}).get("operator"))}
    if not gw_available or not n["operator"]:
        return n
    st = ok(GW, "/node/v1/status")
    if st is None:
        return n
    keys = (ok(GW, "/node/v1/keys", default={}) or {}).get("keys") or []
    m = st.get("machine") or {}
    ex = st.get("exposed") or {}
    paired = [{"name": b.get("name"), "endpoint": b.get("endpoint"), "healthy": bool(b.get("healthy")), "enabled": b.get("enabled", True),
               "error": b.get("error"), "paired": bool(b.get("paired")), "version": b.get("version"), "checked_at": b.get("checked_at"),
               "models": b.get("models") or [], "loaded": [l.get("name") for l in b.get("loaded") or []]}
              for b in st.get("backends") or [] if b.get("remote")]
    n.update({"available": True, "name": st.get("node_name"), "id": st.get("node_id"), "version": st.get("version"), "api_version": st.get("api_version"),
              "uptime_s": st.get("uptime_s"), "started_at": st.get("started_at"), "last_manager_seen_at": st.get("last_manager_seen_at"),
              "exposed": {"enabled": bool(ex.get("enabled")), "host": ex.get("host"), "port": ex.get("port")}, "share": st.get("share"),
              "machine": {k: m.get(k) for k in ("hostname", "os", "arch", "cpu_count", "memory_total", "memory_available", "load_1m", "chassis")},
              "lanes": st.get("lanes") or {}, "counters": st.get("counters") or {},
              "loaded": [{"name": l.get("name"), "backend": l.get("backend")} for l in st.get("loaded") or []], "paired": paired,
              "keys": [{"id": k.get("id"), "name": k.get("name"), "kind": k.get("kind"), "principal": k.get("principal"), "class": (k.get("policy") or {}).get("class"),
                        "created_at": k.get("created_at"), "expires_at": k.get("expires_at"), "revoked_at": k.get("revoked_at"), "last_used_at": k.get("last_used_at")}
                       for k in keys]})
    return n


def node_queue():
    """Live, for the Queue tab: GET /node/v1/queue as the session user (an operator): the jobs and the lanes now."""
    if not os.path.exists(GW):
        return {"ok": False, "error": "no_gateway", "message": "the inference gateway is not on this computer", "queue": [], "lanes": {}}
    try:
        st, body = get(GW, "/node/v1/queue")
    except (OSError, http.client.HTTPException) as e:
        return {"ok": False, "error": "unreachable", "message": f"{e.__class__.__name__}: {str(e)[:120]}", "queue": [], "lanes": {}}
    if st >= 400:
        return {"ok": False, "error": body.get("error") or f"http_{st}", "message": body.get("message") or f"HTTP {st}", "status": st, "queue": [], "lanes": {}}
    return {"ok": True, "queue": body.get("queue") or [], "lanes": body.get("lanes") or {}, "ts": body.get("clock")}


def me_state(me):
    if not me:
        return {"enrolled": False, "principal": None, "policy": None, "budget": {}}
    pol = me.get("policy") or {}
    budget = {}
    for key, period in (("usd_per_day", "day"), ("usd_per_month", "month")):
        limit = (pol.get("budget") or {}).get(key)
        if limit is None:
            continue
        spent = (me.get("spend") or {}).get(period)
        budget[period] = {"limit": float(limit), "spent": float(spent) if spent is not None else None,
                          "warn_at": float((pol.get("budget") or {}).get("warn_at") or 0.8)}
    routes = ok(GW, "/v1/maluos/routes", {"limit": 5}, default={}) or {}
    recent = []
    for r in routes.get("routes") or []:
        route = r.get("route") or []
        last = route[-1] if route else {}
        recent.append({"ts": r.get("ts"), "requested": r.get("requested"), "status": r.get("status"), "reason": r.get("reason"),
                       "backend": last.get("backend"), "model": last.get("model"), "class": r.get("class")})
    return {"enrolled": bool(me.get("enrolled")), "principal": me.get("principal") or me.get("ref"), "kind": me.get("kind"),
            "operator": bool(me.get("operator")), "scopes": me.get("scopes") or [],
            "policy": {k: pol.get(k) for k in ("class", "default_class", "tiers", "allowed_tiers", "cloud", "cloud_allowed", "egress", "max_egress_sensitivity") if pol.get(k) is not None},
            "budget": budget, "recent": recent}


def vault_state():
    v = {"available": os.path.exists(VAULT), "enrolled": False}
    if not v["available"]:
        return v
    who = ok(VAULT, "/v1/whoami")
    if who is None:
        v["available"] = False
        return v
    v.update({"enrolled": bool(who.get("enrolled")), "principal": who.get("principal"), "operator": bool(who.get("operator"))})
    if not v["enrolled"]:
        return v
    secrets = (ok(VAULT, "/v1/secrets", default={}) or {}).get("secrets") or []
    comps = (ok(VAULT, "/v1/compartments", default={}) or {}).get("compartments") or []
    dels = (ok(VAULT, "/v1/delegations", default={}) or {}).get("delegations") or []
    reqs = (ok(VAULT, "/v1/requests", {"status": "pending"}, default={}) or {}).get("requests") or []
    v.update({"secrets": len(secrets), "compartments": [c.get("name") for c in comps],
              "delegations": [{"to": d.get("to") or d.get("to_ref"), "secret": d.get("secret") or d.get("secret_name"),
                               "expires_at": d.get("expires_at")} for d in dels],
              "requests": [{"id": r.get("request_id"), "secret": r.get("secret"), "requester": r.get("requester"), "requester_kind": r.get("requester_kind"),
                            "level": r.get("level"), "purpose": r.get("purpose"), "process": r.get("process"), "asked_count": r.get("asked_count"),
                            "last_asked_at": r.get("last_asked_at"), "mine_to_decide": r.get("owner") == who.get("principal"),
                            "cause": r.get("cause") if isinstance(r.get("cause"), dict) else None} for r in reqs]})
    return v


def alerts_state(since=None):
    if not os.path.exists(VAULT):
        return []
    rows = ok(VAULT, "/v1/ledger", {"event_like": "alert.%", "limit": 20, "since": since}, default={}) or {}
    out = []
    for r in rows.get("events") or []:
        d = r.get("detail") if isinstance(r.get("detail"), dict) else {}
        out.append({"id": r.get("ledger_id"), "ts": str(r.get("ts") or "")[:19], "kind": (r.get("event") or "")[6:],
                    "title": r.get("reason"), "principal": r.get("principal_ref"), "detail": r.get("detail"),
                    "agent": d.get("agent"), "owner": d.get("owner"), "period": d.get("period")})
    return out


def agents_state(units, me=None):
    """Every agent in /etc/maluos/agents, joined with its unit's state (inactive when the unit is not loaded)
    and its owner (slice 3: `mine` when the session user owns it)."""
    names = []
    try:
        names = sorted(f[:-4] for f in os.listdir(AGENTS) if f.endswith(".env"))
    except OSError:
        pass
    out = []
    for n in names:
        a = {"name": n, "principal": f"agent:{n}", "unit": f"maluos-agent@{n}.service", "active": "inactive", "sub": "dead", "exec": None, "sandbox": "standard",
             "owner": None, "mine": False}
        try:
            for line in open(f"{AGENTS}/{n}.env"):
                if line.startswith("MALUOS_PRINCIPAL="):
                    a["principal"] = line.split("=", 1)[1].strip()
                elif line.startswith("MALUOS_AGENT_EXEC="):
                    a["exec"] = json.loads(line.split("=", 1)[1].strip())
                elif line.startswith("MALUOS_AGENT_OWNER="):
                    a["owner"] = line.split("=", 1)[1].strip()
        except (OSError, ValueError):
            pass
        a["mine"] = bool(me) and a["owner"] == me
        if os.path.exists(f"/etc/systemd/system/{a['unit']}.d/sandbox.conf"):
            a["sandbox"] = "strict"
        u = units.get(a["unit"])
        if u:
            a.update({"active": u[0], "sub": u[1], "since": u[2]})
        out.append(a)
    return out


def _marks():
    out = []
    for p in UPDATE_MARKS:
        try:
            out.append(int(os.stat(p).st_mtime))
        except OSError:
            out.append(None)
    return out


def cause_text(c):
    """One line for a request's cause (slice 9): the model call that was refused a credential."""
    if not isinstance(c, dict):
        return ""
    when = (c.get("ts") or "")[11:16]
    return f"for --model {c.get('model') or '?'} ({c.get('backend') or '?'})" + (f" at {when}" if when else "") + (f": {c['task']}" if c.get("task") else "")


def office_conf():
    """/etc/maluos/office.yaml, written by `maluctl office enroll` (no secret in it), or None."""
    try:
        import yaml
        with open(OFFICE_CONF) as fh:
            return yaml.safe_load(fh) or None
    except (OSError, ImportError, ValueError):
        return None


def estate_state(cat):
    """office.estate (Phase 13 slice 1): the estate as the office publishes it to this desk's owner, from
    `maluctl office estate` after a heartbeat: the nodes' summary rows, the open alerts, the counts."""
    if not cat:
        return {"available": False, "error": None, "nodes": [], "alerts": [], "counts": {}}
    keys = ("id", "kind", "name", "hostname", "presence", "health", "summary", "last_seen_at", "last_report_at", "units", "agents", "gateway", "updates",
            "disk_max_pct", "memory_available_pct", "load1")
    nodes = []
    for n in cat.get("nodes") or []:
        row = {k: n.get(k) for k in keys}
        if n.get("kind") == "desk":
            row["owner"] = (n.get("owner") or {}).get("display_name")
        nodes.append(row)
    alerts = [{k: a.get(k) for k in ("id", "ts", "node_id", "node", "kind", "severity", "title", "cleared_at")} for a in cat.get("alerts") or []]
    return {"available": bool(cat.get("available")), "fetched_at": cat.get("fetched_at"), "stale": bool(cat.get("stale")), "error": cat.get("error"),
            "nodes": nodes, "alerts": alerts, "counts": cat.get("counts") or {}}


def office_state(conf, hb, agents=None, apps=None, estate=None):
    """What the desk knows about its office: the enrolment, the last heartbeat's outcome, (slice 8) its agents and
    (Phase 13 slice 1) the estate when the office publishes it to this desk's owner."""
    if not conf:
        return {"enrolled": False}
    hb = dict(hb or {})
    hb.pop("_at", None)
    agents = agents or {}
    apps = apps or {}
    eps = conf.get("endpoints") or {}
    models = eps.get("models") if isinstance(eps.get("models"), dict) else None
    d = hb.get("desk") or conf.get("desk") or {}
    g = conf.get("gateway") or {}
    presence = "retired" if hb.get("revoked") else "online" if hb.get("ok") else "unreachable" if hb.get("error") else "unknown"
    return {"enrolled": True, "url": conf.get("url"), "office": conf.get("office") or {}, "surface": conf.get("surface"),
            "desk": {"id": d.get("id"), "name": d.get("name"), "status": d.get("status")}, "owner": conf.get("owner") or {},
            "heartbeat_s": conf.get("heartbeat_s"), "enrolled_at": conf.get("enrolled_at"),
            "endpoints": {**{k: bool(eps.get(k)) for k in ("records", "activity", "memory", "actions")}, "models": list(models.get("models") or []) if models else None},
            "gateway": g.get("alias") or g.get("backend"), "presence": presence, "ok": bool(hb.get("ok")),
            "last_heartbeat_at": hb.get("ts") if hb.get("ok") else None, "last_error": hb.get("error"), "revoked": bool(hb.get("revoked")),
            "agents": [a for a in (agents.get("agents") or []) if agents.get("office_url") == conf.get("url")], "agents_error": agents.get("error"),
            "agents_fetched_at": agents.get("fetched_at"),
            "apps": {"count": len(apps.get("apps") or []), "installed": sum(1 for a in apps.get("apps") or [] if a.get("installed")),
                     "fetched_at": apps.get("fetched_at"), "stale": bool(apps.get("stale")), "errors": apps.get("errors") or []} if apps else None,
            "estate": estate_state(estate)}


def updates_state():
    """Software updates as `maluctl update status --json` reports them (python3-apt, no privileges).
    The marks (mtimes of apt's and dpkg's state) are taken before the read, so a change during it
    triggers another."""
    marks = _marks()
    now = int(time.time())
    try:
        r = subprocess.run(["maluctl", "update", "status", "--json", "--compact"], capture_output=True, text=True, timeout=UPDATES_TIMEOUT)
        d = json.loads(r.stdout)
    except (OSError, ValueError, subprocess.SubprocessError) as e:
        return {"available": False, "error": f"{e.__class__.__name__}: {str(e)[:120]}", "read_at": now, "_marks": marks}
    pending = [{"name": p.get("name"), "installed": p.get("installed"), "candidate": p.get("candidate"), "source": p.get("source"),
                "security": bool(p.get("security")), "automatic": bool(p.get("automatic"))} for p in d.get("pending") or []]
    return {"available": True, "read_at": now, "_marks": marks,
            "pending": pending[:60], "pending_count": d.get("pending_count", len(pending)),
            "security_count": d.get("security_count", 0), "automatic_count": d.get("automatic_count", 0),
            "manual_count": d.get("pending_count", len(pending)) - d.get("automatic_count", 0),
            "pending_error": d.get("pending_error"), "by_source": d.get("by_source") or {},
            "lists_refreshed": d.get("lists_refreshed"), "lists_refreshed_at": d.get("lists_refreshed_at"),
            "last_automatic_run": d.get("last_automatic_run"), "last_automatic_run_at": d.get("last_automatic_run_at"),
            "automatic": d.get("automatic") or {}, "auto": d.get("auto") or {}, "reboot_required": bool(d.get("reboot_required")),
            "reboot_packages": d.get("reboot_packages") or []}


# ---------------------------------------------------------------- the service
class Service:
    def __init__(self, once=False):
        from gi.repository import Gio, GLib
        self.Gio, self.GLib = Gio, GLib
        self.once = once
        self.state = {"version": VERSION, "ts": 0, "host": host_state(), "gateway": {"available": False}, "me": {}, "node": {"available": False, "operator": False},
                      "vault": {}, "agents": [], "alerts": [], "updates": {"available": False}, "office": {"enrolled": False}}
        self.office_hb = None            # the last heartbeat's outcome (office thread writes, under office_lock)
        self.office_lock = threading.Lock()
        self.office_wake = threading.Event()
        self.office_force = False
        self.office_token = None         # the desk token, read from the vault once per enrolment (not persisted)
        self.office_agents = None        # the office's agents, from `maluctl office agents` after a heartbeat (slice 8)
        self.office_apps = None          # the MaluApps catalogue summary, re-read after a heartbeat (slice 7 leftover)
        self.office_estate = None        # the estate as the office publishes it to this desk's owner (Phase 13 slice 1)
        self.estate_notified = set()     # ids of the estate alerts already notified
        self.icons_key = None            # what the agent icons were last synced for (slice 8)
        self.updates = None              # the last reading (updates thread writes, under updates_lock)
        self.updates_lock = threading.Lock()
        self.updates_wake = threading.Event()
        self.updates_force = False
        self.updates_last_action = None  # the last apply/auto action's outcome: {action, ok, error, ts}
        self.updates_reading = False
        self.updates_notified = ()       # the set of manual updates last notified
        self.prev = None
        self.alert_floor = None          # ledger id of the newest alert seen; older ones are not notified
        self.budget_notified = {}
        self.lock = threading.Lock()
        self.wake = threading.Event()
        self.system = None
        self.session = None
        self.notify_proxy = None
        self.request_notified = {}       # request id -> notification id (slice 3)
        self.notification_ctx = {}       # notification id -> ("request", id) | ("updates",) | ("restart",)
        self.conn = None
        self.reg_id = None
        self.pending_refresh = None

    # -- systemd (system bus): agent units, read-only for anyone, start/stop through polkit
    def systemd(self):
        if self.system is None:
            Gio = self.Gio
            self.system = Gio.DBusProxy.new_for_bus_sync(Gio.BusType.SYSTEM, Gio.DBusProxyFlags.DO_NOT_LOAD_PROPERTIES, None,
                                                         "org.freedesktop.systemd1", "/org/freedesktop/systemd1", "org.freedesktop.systemd1.Manager", None)
        return self.system

    def units(self):
        GLib = self.GLib
        try:
            res = self.systemd().call_sync("ListUnitsByPatterns", GLib.Variant("(asas)", ([], ["maluos-agent@*.service"])), 0, 5000, None).unpack()[0]
        except Exception as e:
            log(f"systemd: {e.__class__.__name__}: {str(e)[:120]}")
            return {}
        out = {}
        for row in res:
            name, _desc, _load, active, sub = row[:5]
            since = None
            if active in ("active", "failed"):
                try:
                    p = self.Gio.DBusProxy.new_for_bus_sync(self.Gio.BusType.SYSTEM, self.Gio.DBusProxyFlags.DO_NOT_LOAD_PROPERTIES, None,
                                                            "org.freedesktop.systemd1", row[6], "org.freedesktop.DBus.Properties", None)
                    key = "ActiveEnterTimestamp" if active == "active" else "InactiveEnterTimestamp"
                    v = p.call_sync("Get", GLib.Variant("(ss)", ("org.freedesktop.systemd1.Unit", key)), 0, 2000, None).unpack()[0]
                    since = int(v / 1e6) if v else None
                except Exception:
                    pass
            out[name] = (active, sub, since)
        return out

    def watch_units(self):
        """JobRemoved fires when a start/stop/restart of a unit finishes: refresh then."""
        Gio = self.Gio
        try:
            self.systemd().call_sync("Subscribe", None, 0, 5000, None)
        except Exception as e:
            log(f"systemd Subscribe: {str(e)[:120]}")
        bus = Gio.bus_get_sync(Gio.BusType.SYSTEM, None)

        def on_job(_c, _s, _p, _i, _sig, params):
            # JobRemoved is (u id, o job, s unit, s result); UnitRemoved is (s unit, o path)
            unit = next((a for a in params.unpack() if isinstance(a, str) and a.endswith(".service")), "")
            if unit.startswith("maluos-agent@"):
                self.refresh_soon(1.5)
        bus.signal_subscribe("org.freedesktop.systemd1", "org.freedesktop.systemd1.Manager", "JobRemoved", "/org/freedesktop/systemd1", None, 0, on_job)
        bus.signal_subscribe("org.freedesktop.systemd1", "org.freedesktop.systemd1.Manager", "UnitRemoved", "/org/freedesktop/systemd1", None, 0, on_job)

    def agent_action(self, name, action):
        GLib = self.GLib
        if not NAME_RE.match(name):
            raise ValueError(f"bad agent name {name!r}")
        method = {"start": "StartUnit", "stop": "StopUnit", "restart": "RestartUnit"}.get(action)
        if not method:
            raise ValueError(f"unknown action {action!r} (start, stop, restart)")
        # The user's own polkit prompt answers org.freedesktop.systemd1.manage-units.
        self.systemd().call_sync(method, GLib.Variant("(ss)", (f"maluos-agent@{name}.service", "replace")),
                                 self.Gio.DBusCallFlags.ALLOW_INTERACTIVE_AUTHORIZATION, 120000, None)

    # -- collecting
    def collect(self):
        units = self.units()
        gw, me = gateway_state()
        vault = vault_state()
        mine = vault.get("principal") or (me or {}).get("principal") or (me or {}).get("ref")
        with self.updates_lock:
            u = {k: v for k, v in (self.updates or {"available": False}).items() if not k.startswith("_")}
            u["reading"] = self.updates_reading
            u["last_action"] = self.updates_last_action
        with self.office_lock:
            hb = self.office_hb; oa = self.office_agents; op = self.office_apps; oe = self.office_estate
        st = {"version": VERSION, "ts": int(time.time()), "host": host_state(), "gateway": gw, "me": me_state(me), "node": node_state(gw.get("available"), me),
              "vault": vault, "agents": agents_state(units, mine), "alerts": alerts_state(), "updates": u, "office": office_state(office_conf(), hb, oa, op, oe)}
        return st

    def office_estate_read(self):
        """`maluctl office estate --json --refresh` as this user: the estate when the office publishes it (endpoints.estate)."""
        env = dict(os.environ)
        if self.office_token:
            env["MALUOS_OFFICE_TOKEN"] = self.office_token
        try:
            r = subprocess.run(["maluctl", "office", "estate", "--json", "--compact", "--refresh"], capture_output=True, text=True, timeout=60, env=env)
            return json.loads(r.stdout)
        except (OSError, ValueError, subprocess.SubprocessError) as e:
            return {"available": False, "fetched_at": int(time.time()), "nodes": [], "alerts": [], "counts": {}, "error": f"maluctl office estate: {e.__class__.__name__}: {str(e)[:120]}"}

    def office_apps_read(self):
        """`maluctl office apps --json --refresh` as this user: the merged catalogue, written to the per-user cache the MaluApps window reads."""
        env = dict(os.environ)
        if self.office_token:
            env["MALUOS_OFFICE_TOKEN"] = self.office_token
        try:
            r = subprocess.run(["maluctl", "office", "apps", "--json", "--compact", "--refresh"], capture_output=True, text=True, timeout=90, env=env)
            return json.loads(r.stdout.strip().splitlines()[-1])
        except Exception as e:
            return {"fetched_at": int(time.time()), "apps": [], "errors": [f"maluctl office apps: {e.__class__.__name__}: {str(e)[:120]}"]}

    def office_agents_read(self):
        """`maluctl office agents --json` as this user (the token from the vault, or the cached one)."""
        env = dict(os.environ)
        if self.office_token:
            env["MALUOS_OFFICE_TOKEN"] = self.office_token
        try:
            r = subprocess.run(["maluctl", "office", "agents", "--json", "--compact", "--refresh"], capture_output=True, text=True, timeout=60, env=env)
            return json.loads(r.stdout.strip().splitlines()[-1])
        except Exception as e:
            return {"fetched_at": int(time.time()), "agents": [], "error": f"maluctl office agents: {e.__class__.__name__}: {str(e)[:120]}"}

    def icons_sync(self, st):
        """Run `maluos-agents --sync` (when installed) whenever the set of agents the icons show has changed."""
        key = json.dumps([[a["name"], a.get("owner"), a.get("exec")] for a in st.get("agents") or []]
                         + [[str(a.get("id")), a.get("name"), a.get("icon")] for a in (st.get("office") or {}).get("agents") or []], sort_keys=True)
        if key == self.icons_key or not os.path.exists("/usr/bin/maluos-agents"):
            return
        self.icons_key = key

        def run():
            try:
                r = subprocess.run(["maluos-agents", "--sync"], capture_output=True, text=True, timeout=60)
                log(f"icons: {(r.stdout or r.stderr).strip()[:160]}")
            except Exception as e:
                log(f"icons: {e.__class__.__name__}: {str(e)[:120]}")
        threading.Thread(target=run, daemon=True).start()

    def updates_loop(self):
        """Its own thread: re-read `maluctl update status` when apt's or dpkg's state changed on disk,
        when asked (UpdateAction refresh), every UPDATES_EVERY seconds, or UPDATES_RETRY after a failure.
        The reading can take long; the poll loop and the bus never wait for it."""
        while True:
            try:
                with self.updates_lock:
                    prev = self.updates; force = self.updates_force; self.updates_force = False
                now = int(time.time())
                due = force or prev is None or _marks() != prev.get("_marks") \
                    or now - prev.get("read_at", 0) >= (UPDATES_EVERY if prev.get("available") else UPDATES_RETRY)
                if due:
                    with self.updates_lock:
                        self.updates_reading = True
                    d = updates_state()
                    with self.updates_lock:
                        self.updates = d; self.updates_reading = False
                    if not d.get("available"):
                        log(f"updates: {d.get('error')}")
                    self.refresh_soon(0.5)
            except Exception as e:
                log(f"updates: {e.__class__.__name__}: {str(e)[:160]}")
                with self.updates_lock:
                    self.updates_reading = False
            self.updates_wake.wait(POLL); self.updates_wake.clear()

    # -- the office (slice 6): presence heartbeats while the person is signed in
    def office_heartbeat(self, presence="online"):
        """`maluctl office heartbeat --json` as this user, with the cached token when there is one."""
        env = dict(os.environ)
        if self.office_token:
            env["MALUOS_OFFICE_TOKEN"] = self.office_token
        try:
            r = subprocess.run(["maluctl", "office", "heartbeat", "--json", "--presence", presence], capture_output=True, text=True, timeout=60, env=env)
            d = json.loads(r.stdout.strip().splitlines()[-1])
        except Exception as e:
            d = {"ts": time.strftime("%Y-%m-%dT%H:%M:%SZ", time.gmtime()), "ok": False, "presence": presence, "revoked": False,
                 "error": f"maluctl office heartbeat: {e.__class__.__name__}: {str(e)[:120]}"}
        d["_at"] = time.time()
        return d

    def office_loop(self):
        """Its own thread: while /etc/maluos/office.yaml exists, heartbeat every heartbeat_s (OFFICE_RETRY after a
        failure; thrice the interval once the office retired the desk), or when asked (OfficeAction heartbeat)."""
        while True:
            try:
                conf = office_conf()
                with self.office_lock:
                    force = self.office_force; self.office_force = False; prev = self.office_hb
                if not conf:
                    if prev is not None or self.office_token or self.office_agents or self.office_apps or self.office_estate:
                        with self.office_lock:
                            self.office_hb = None; self.office_agents = None; self.office_apps = None; self.office_estate = None
                        self.office_token = None
                        self.refresh_soon(0.5)
                else:
                    every = int(conf.get("heartbeat_s") or 300)
                    since = time.time() - (prev or {}).get("_at", 0)
                    due = force or prev is None or since >= (every * 3 if prev.get("revoked") else every if prev.get("ok") else OFFICE_RETRY)
                    if due:
                        if not self.office_token:
                            try:
                                st, body = get(VAULT, f"/v1/secrets/{OFFICE_SECRET}/value", {"mode": "read", "purpose": "office heartbeat"})
                                if st != 200 or not body.get("value"):
                                    raise RuntimeError(f"{st} {body.get('error') or ''}: {body.get('message') or ''}".strip())
                                self.office_token = body["value"]
                            except Exception as e:
                                log(f"office: token not readable from the vault ({str(e)[:100]}); the heartbeat command will try itself")
                        d = self.office_heartbeat("online")
                        if d.get("revoked"):
                            self.office_token = None
                        if not d.get("ok"):
                            log(f"office: heartbeat failed: {d.get('error')}")
                        oa = self.office_agents_read() if d.get("ok") else ({"fetched_at": int(time.time()), "agents": [], "error": "the office retired this desk"} if d.get("revoked") else None)
                        op = self.office_apps_read() if d.get("ok") else None
                        oe = self.office_estate_read() if d.get("ok") and (conf.get("endpoints") or {}).get("estate") else None
                        with self.office_lock:
                            self.office_hb = d
                            if oa is not None:
                                self.office_agents = oa
                            if op is not None:
                                self.office_apps = op
                            if oe is not None:
                                self.office_estate = oe
                        self.refresh_soon(0.5)
            except Exception as e:
                log(f"office: {e.__class__.__name__}: {str(e)[:160]}")
            self.office_wake.wait(POLL); self.office_wake.clear()

    def office_goodbye(self):
        """The session ends: tell the office the desk is offline (best effort, a few seconds)."""
        if not office_conf():
            return
        try:
            d = self.office_heartbeat("offline")
            log("office: said offline" if d.get("ok") else f"office: offline heartbeat failed: {d.get('error')}")
        except Exception as e:
            log(f"office: goodbye: {str(e)[:100]}")

    def office_action(self, action):
        """open: the office in the browser; heartbeat: check in now; estate: the System Monitor's MaluOS Network tab."""
        if action == "open":
            conf = office_conf()
            if not conf:
                raise ValueError("not enrolled with an office")
            subprocess.Popen(["xdg-open", conf.get("url")], stdin=subprocess.DEVNULL, stdout=subprocess.DEVNULL, stderr=subprocess.DEVNULL)
        elif action == "heartbeat":
            with self.office_lock:
                self.office_force = True
            self.office_wake.set()
        elif action == "estate":
            subprocess.Popen(["gnome-system-monitor", "--show-network-tab"], stdin=subprocess.DEVNULL, stdout=subprocess.DEVNULL, stderr=subprocess.DEVNULL, start_new_session=True)
        else:
            raise ValueError(f"unknown office action {action!r} (open, heartbeat, estate)")

    def poll_loop(self):
        while True:
            try:
                st = self.collect()
                self.GLib.idle_add(self.apply, st)
            except Exception as e:
                log(f"poll: {e.__class__.__name__}: {str(e)[:160]}")
            self.wake.wait(POLL); self.wake.clear()

    def refresh_soon(self, delay=0.0):
        if delay <= 0:
            self.wake.set(); return
        if self.pending_refresh:
            return
        def fire():
            self.pending_refresh = None; self.wake.set(); return False
        self.pending_refresh = self.GLib.timeout_add(int(delay * 1000), fire)

    # -- applying: diff, notify, publish
    def apply(self, st):
        prev = self.prev
        with self.lock:
            self.state = st
            self.prev = st
        if prev is not None:
            self.diff(prev, st)
        else:
            self.alert_floor = max([a["id"] for a in st["alerts"] if a.get("id")] or [0])
        if self.conn:
            self.conn.emit_signal(None, OBJ, IFACE, "StateChanged", self.GLib.Variant("(s)", (json.dumps(st, default=str),)))
        if not self.once:
            self.icons_sync(st)
        return False

    def diff(self, old, new):
        # agents: steady-state changes only
        o = {a["name"]: a for a in old["agents"]}
        for a in new["agents"]:
            was = o.get(a["name"])
            if was is None:
                self.notify(f"Agent {a['name']} created", f"maluos-agent@{a['name']} ({a['active']})"); continue
            if a["active"] != was["active"] and a["active"] in STEADY and was["active"] in STEADY:
                if a["active"] == "failed":
                    self.notify(f"Agent {a['name']} failed", f"{a['unit']} ({a['sub']}); see its logs", urgency=2)
                elif a["active"] == "active":
                    self.notify(f"Agent {a['name']} is running", a["exec"] or a["unit"])
                else:
                    self.notify(f"Agent {a['name']} stopped", a["unit"])
        for name in set(o) - {a["name"] for a in new["agents"]}:
            self.notify(f"Agent {name} removed", f"maluos-agent@{name} is gone from this host")
        # the gateway and its backends
        og, ng = old["gateway"], new["gateway"]
        if og.get("available") != ng.get("available"):
            self.notify("Inference gateway " + ("available" if ng.get("available") else "not available"),
                        "models are reachable at the gateway socket again" if ng.get("available") else "the gateway socket is gone; model calls will fail")
        ob = {b["name"]: b["healthy"] for b in og.get("backends") or []}
        for b in ng.get("backends") or []:
            if b["name"] in ob and ob[b["name"]] != b["healthy"]:
                self.notify(f"Model backend {b['name']} " + ("is back" if b["healthy"] else "is down"),
                            "calls route around it while it is unhealthy" if not b["healthy"] else "healthy again", urgency=2 if not b["healthy"] else 1)
        # budget thresholds (the user's own policy), once per period
        for period, b in (new["me"].get("budget") or {}).items():
            if b.get("spent") is None or not b.get("limit"):
                continue
            key = f"{period}:{time.strftime('%Y-%m-%d' if period == 'day' else '%Y-%m')}"
            level = "over" if b["spent"] >= b["limit"] else "warn" if b["spent"] >= b["warn_at"] * b["limit"] else None
            if level and self.budget_notified.get(key) != level:
                self.budget_notified[key] = level
                self.notify(f"Model budget {'exhausted' if level == 'over' else 'nearly used'} ({period})",
                            f"{b['spent']:.2f} of {b['limit']:.2f} USD this {period}", urgency=2 if level == "over" else 1)
        # vault grant requests I must decide (slice 3): one notification per request, with Allow and Deny
        seen = set()
        for r in (new["vault"].get("requests") or []):
            if not r.get("mine_to_decide") or not r.get("id"):
                continue
            seen.add(r["id"])
            key = (r["id"], r.get("asked_count"))
            if self.request_notified.get(r["id"]) == key:
                continue
            self.request_notified[r["id"]] = key
            who = r["requester"] or "?"
            kind = "Agent" if r.get("requester_kind") == "agent" else "Principal"
            name = who.split(":", 1)[1] if ":" in who else who
            times = f" (asked {r['asked_count']} times)" if (r.get("asked_count") or 1) > 1 else ""
            cause = cause_text(r.get("cause"))
            self.notify(f"{kind} {name} asks for {r['secret']}", (f"{cause} · " if cause else "") + (f"{r['purpose']} · " if r.get("purpose") else "") + f"{r['level']} access{times}",
                        urgency=1, actions=[("approve", "Allow for a week"), ("choose", "Choose…"), ("deny", "Deny")], request_id=r["id"])
        for rid in [k for k in self.request_notified if k not in seen]:
            self.request_notified.pop(rid, None)
        # new alert rows for me in the ledger
        me = new["vault"].get("principal") or (new.get("me") or {}).get("principal")
        for a in sorted(new["alerts"], key=lambda a: a.get("id") or 0):
            if a.get("id") and (self.alert_floor is None or a["id"] > self.alert_floor):
                self.alert_floor = a["id"]
                if a.get("agent") and a["kind"] in ("budget", "budget_exceeded"):
                    # slice 9: the agent's budget alert, told to its owner by name
                    whose = "your agent" if a.get("owner") and a["owner"] == me else "agent"
                    self.notify(f"Agent {a['agent']}: budget {'exhausted' if a['kind'] == 'budget_exceeded' else 'nearly used'}" + (f" ({a['period']})" if a.get("period") else ""),
                                f"{whose} {a['agent']}: {a.get('title') or ''}", urgency=2 if a["kind"] == "budget_exceeded" else 1)
                else:
                    self.notify(f"Alert: {a['kind']}", a.get("title") or "", urgency=1)
        # software updates (slice 5): the ones that wait for the user, once per set; a pending restart, once
        ou, nu = old.get("updates") or {}, new.get("updates") or {}
        if nu.get("available"):
            manual = [p["name"] for p in nu.get("pending") or [] if not p.get("automatic")]
            key = tuple(sorted(manual))
            if manual and key != self.updates_notified:
                self.updates_notified = key
                n, sec, auto = nu.get("pending_count", 0), nu.get("security_count", 0), nu.get("automatic_count", 0)
                body = f"{len(manual)} wait for you" + (f" · {auto} install on their own" if auto else "") + (f" · {sec} security" if sec else "")
                self.notify(f"{n} software update{'s' if n != 1 else ''} available", body, urgency=1, actions=[("install", "Install")], ctx=("updates",))
            elif not manual:
                self.updates_notified = ()
            if nu.get("reboot_required") and not ou.get("reboot_required"):
                pk = nu.get("reboot_packages") or []
                self.notify("Restart to finish updates", ", ".join(pk[:6]) + (" …" if len(pk) > 6 else "") if pk else "an installed update needs a restart",
                            urgency=1, actions=[("restart", "Restart now")], ctx=("restart",))

        # the office (slice 6): joined, retired by the office, lost and found
        oo, no = old.get("office") or {}, new.get("office") or {}
        if no.get("enrolled") and not oo.get("enrolled"):
            self.notify(f"This desk joined {no['office'].get('name') or no.get('url')}", f"desk {no['desk'].get('name') or '?'} for {no['owner'].get('display_name') or no['owner'].get('principal') or 'you'}"
                        + (f" · models: --model {no['gateway']}" if no.get("gateway") else ""))
        elif oo.get("enrolled") and not no.get("enrolled"):
            self.notify("This desk left its office", f"{oo['office'].get('name') or oo.get('url')}: the enrolment was removed")
        elif no.get("enrolled"):
            if no.get("revoked") and not oo.get("revoked"):
                self.notify("The office retired this desk", f"{no['office'].get('name') or no.get('url')} no longer accepts this desk's token; sudo maluctl office leave removes the enrolment", urgency=2)
            elif oo.get("presence") == "online" and no.get("presence") == "unreachable":
                self.notify("Office unreachable", f"{no['office'].get('name') or no.get('url')}: {no.get('last_error') or 'the heartbeat failed'}", urgency=1)
            elif oo.get("presence") == "unreachable" and no.get("presence") == "online":
                self.notify("Office reachable again", f"{no['office'].get('name') or no.get('url')} sees this desk online")
        # the estate (Phase 13 slice 1): a node went offline or came back; an alert the office raised, once per alert
        oe, ne = oo.get("estate") or {}, no.get("estate") or {}
        if ne.get("available"):
            office_name = no["office"].get("name") or no.get("url")
            was = {n.get("id"): n for n in oe.get("nodes") or []} if oe.get("available") else {}
            for n in ne.get("nodes") or []:
                w = was.get(n.get("id"))
                if w and w.get("presence") == "online" and n.get("presence") != "online":
                    self.notify(f"{n.get('name')} is offline", f"{n.get('kind')} node of {office_name}: no heartbeat", urgency=2, actions=[("estate", "Open Estate")], ctx=("estate",))
                elif w and w.get("presence") != "online" and n.get("presence") == "online":
                    self.notify(f"{n.get('name')} is back", f"{n.get('kind')} node of {office_name}: online again")
            open_ids = {a["id"] for a in ne.get("alerts") or [] if a.get("id") and not a.get("cleared_at")}
            if oe.get("available"):
                for a in ne.get("alerts") or []:
                    if a.get("id") in open_ids and a["id"] not in self.estate_notified and a.get("kind") != "node_offline":
                        self.notify(f"{a.get('node')}: {a.get('title')}", f"{a.get('severity')} {a.get('kind')} in the estate of {office_name}",
                                    urgency=2 if a.get("severity") == "critical" else 1, actions=[("estate", "Open Estate")], ctx=("estate",))
            self.estate_notified = open_ids
        elif oe.get("available"):
            self.estate_notified = set()

    def notify(self, summary, body="", urgency=1, actions=None, request_id=None, ctx=None):
        if request_id and ctx is None:
            ctx = ("request", request_id)
        log(f"notify: {summary}" + (f" — {body}" if body else ""))
        if self.once or not self.session:
            return
        GLib = self.GLib
        try:
            if self.notify_proxy is None:
                self.notify_proxy = self.Gio.DBusProxy.new_sync(self.session, self.Gio.DBusProxyFlags.DO_NOT_LOAD_PROPERTIES, None,
                                                                "org.freedesktop.Notifications", "/org/freedesktop/Notifications", "org.freedesktop.Notifications", None)
                self.session.signal_subscribe("org.freedesktop.Notifications", "org.freedesktop.Notifications", None, "/org/freedesktop/Notifications",
                                              None, 0, self.on_notification_signal)
            hints = {"urgency": GLib.Variant("y", urgency), "desktop-entry": GLib.Variant("s", "maluos-session")}
            if ctx:
                hints["resident"] = GLib.Variant("b", True)
            acts = [x for pair in (actions or []) for x in pair]
            def done(proxy, res, _):
                try:
                    nid = proxy.call_finish(res).unpack()[0]
                    if ctx:
                        self.notification_ctx[nid] = ctx
                except Exception as e:
                    log(f"notification failed: {e.__class__.__name__}: {str(e)[:120]}")
            # Asynchronous: the shell can be slow to answer (software rendering, a busy session), and
            # neither the poll loop nor the main loop should wait on it. The reply lands in the main loop.
            self.notify_proxy.call("Notify", GLib.Variant("(susssasa{sv}i)", ("MaluOS", 0, "maluos-logo", summary, body, acts, hints, -1)), 0, 30000, None, done, None)
        except Exception as e:
            log(f"notification failed: {e.__class__.__name__}: {str(e)[:120]}")

    def on_notification_signal(self, _conn, _sender, _path, _iface, signal, params):
        """ActionInvoked(id, key): Allow or Deny on a request notification, Install or Restart on an updates one;
        NotificationClosed(id, reason)."""
        try:
            if signal == "ActionInvoked":
                nid, key = params.unpack()
                ctx = self.notification_ctx.get(nid) or ()
                if ctx[:1] == ("request",) and key in ("approve", "deny"):
                    rid = ctx[1]
                    log(f"request #{rid}: {key} from the notification")
                    try:
                        self.request_decide(rid, key, "7d" if key == "approve" else "")
                    except Exception as e:
                        self.notify(f"Request #{rid}: {key} failed", str(e)[:120], urgency=2)
                    self.refresh_soon(0.5)
                elif ctx[:1] == ("request",) and key == "choose":
                    rid = ctx[1]
                    log(f"request #{rid}: Choose… opens the Credential Manager")
                    subprocess.Popen(["maluos-desk", "--window", "vault", "--request", str(rid)], stdin=subprocess.DEVNULL, stdout=subprocess.DEVNULL, stderr=subprocess.DEVNULL)
                elif key == "estate":
                    log("estate: Open Estate from the notification"); self.office_action("estate")
                elif key == "install":
                    log("updates: Install from the notification"); self.update_action("open")
                elif key == "restart":
                    log("updates: Restart from the notification"); self.update_action("restart")
            elif signal == "NotificationClosed":
                nid, _reason = params.unpack()
                self.notification_ctx.pop(nid, None)
        except Exception as e:
            log(f"notification signal: {e.__class__.__name__}: {str(e)[:120]}")

    def request_decide(self, rid, decision, expires=""):
        """Answer a vault grant request as the session user (the vault checks that the user owns the secret).
        EXPIRES is a duration ("7d", "" for none) or, since slice 9, JSON with the decision's parameters:
        {"expires": "30d"|null, "level": "use"|"read", "budget": {"usd_per_day": 10}|null}."""
        if decision not in ("approve", "deny"):
            raise ValueError("decision must be approve or deny")
        body = {}
        if decision == "approve":
            opts = {}
            if expires and expires.strip().startswith("{"):
                opts = json.loads(expires)
                if not isinstance(opts, dict):
                    raise ValueError("options must be a JSON object")
            else:
                opts = {"expires": expires or None}
            if opts.get("level") not in (None, "use", "read"):
                raise ValueError("level must be use or read")
            budget = opts.get("budget")
            if budget is not None and not (isinstance(budget, dict) and all(isinstance(v, (int, float)) for v in budget.values())):
                raise ValueError("budget must be an object of numbers (usd_per_day, …)")
            body = {"expires_at": opts.get("expires") or None, "level": opts.get("level"), "budget": budget}
        st, obj = post(VAULT, f"/v1/requests/{int(rid)}/{decision}", body)
        if st >= 400:
            raise RuntimeError(obj.get("message") or obj.get("error") or f"HTTP {st}")
        return obj

    def update_action(self, action):
        """open: the updates page (GNOME Software when present, else `maluctl update` in a terminal);
        restart: the session's own restart dialog; refresh: drop the cached reading and re-read."""
        import shutil
        if action == "open":
            if shutil.which("gnome-software"):
                subprocess.Popen(["gnome-software", "--mode=updates"], stdin=subprocess.DEVNULL, stdout=subprocess.DEVNULL, stderr=subprocess.DEVNULL)
            else:
                subprocess.Popen(["xdg-terminal-exec", "sh", "-c", "maluctl update status; echo; echo 'sudo maluctl update apply --all installs everything pending'; exec \"${SHELL:-bash}\""],
                                 stdin=subprocess.DEVNULL, stdout=subprocess.DEVNULL, stderr=subprocess.DEVNULL)
        elif action == "restart":
            subprocess.Popen(["gnome-session-quit", "--reboot"], stdin=subprocess.DEVNULL, stdout=subprocess.DEVNULL, stderr=subprocess.DEVNULL)
        elif action == "refresh":
            with self.updates_lock:
                self.updates_force = True
            self.updates_wake.set()
        elif action in ("apply", "apply-all"):
            # Install now, with apt's log live: a terminal running maluctl update apply as root (pkexec, the
            # shell's polkit agent asks). The updates thread re-reads when dpkg's state changes.
            extra = " --all" if action == "apply-all" else ""
            subprocess.Popen(["xdg-terminal-exec", "sh", "-c", f"pkexec maluctl update apply{extra} -y; echo; echo '--- done (maluctl update apply{extra}); press Enter to close'; read _"],
                             stdin=subprocess.DEVNULL, stdout=subprocess.DEVNULL, stderr=subprocess.DEVNULL)
        elif action.startswith("auto:"):
            parts = action.split(":")[1:]
            argv = None
            if parts[0] in ("on", "off") and len(parts) == 1:
                argv = [parts[0]]
            elif parts[0] == "set" and len(parts) == 3 and parts[1] in ("security", "maluos", "mozilla") and parts[2] in ("on", "off"):
                argv = ["set", parts[1], parts[2]]
            elif parts[0] == "reboot" and len(parts) in (2, 3) and parts[1] in ("on", "off"):
                argv = ["reboot", parts[1]] + (["--at", parts[2]] if len(parts) == 3 else [])
            if argv is None:
                raise ValueError(f"unknown update action {action!r}")
            threading.Thread(target=self.update_auto, args=(action, argv), daemon=True).start()
        else:
            raise ValueError(f"unknown update action {action!r} (open, restart, refresh, apply, apply-all, auto:…)")

    def update_auto(self, action, argv):
        """`pkexec maluctl update auto ARGV` (polkit com.maluos.admin); the outcome goes to
        updates.last_action and the updates thread re-reads the switches."""
        try:
            r = subprocess.run(["pkexec", "maluctl", "update", "auto", *argv], capture_output=True, text=True, timeout=300, stdin=subprocess.DEVNULL)
            ok = r.returncode == 0
            err = "" if ok else (r.stderr.strip().splitlines() or ["cancelled" if r.returncode in (126, 127) else f"exit {r.returncode}"])[-1][:160]
        except (OSError, subprocess.SubprocessError) as e:
            ok, err = False, f"{e.__class__.__name__}: {str(e)[:120]}"
        if not ok:
            log(f"update auto {' '.join(argv)}: {err}")
        with self.updates_lock:
            self.updates_last_action = {"action": action, "ok": ok, "error": err, "ts": int(time.time())}
            self.updates_force = True
        self.updates_wake.set()
        self.refresh_soon(0.2)

    # -- D-Bus
    def on_call(self, conn, sender, path, iface, method, params, invocation):
        GLib = self.GLib
        try:
            if method == "GetState":
                with self.lock:
                    invocation.return_value(GLib.Variant("(s)", (json.dumps(self.state, default=str),)))
            elif method == "Refresh":
                self.refresh_soon(); invocation.return_value(None)
            elif method == "AgentAction":
                name, action = params.unpack()
                self.agent_action(name, action)
                self.refresh_soon(1.0)
                invocation.return_value(None)
            elif method == "RequestDecide":
                rid, decision, expires = params.unpack()
                obj = self.request_decide(rid, decision, expires)
                self.refresh_soon(0.5)
                invocation.return_value(GLib.Variant("(s)", (json.dumps(obj, default=str),)))
            elif method == "UpdateAction":
                self.update_action(params.unpack()[0])
                invocation.return_value(None)
            elif method == "OfficeAction":
                self.office_action(params.unpack()[0])
                invocation.return_value(None)
            elif method == "NodeQueue":
                # the gateway answers in milliseconds, but never hold the bus on it: a thread reads, the main loop replies
                def work():
                    d = node_queue()
                    GLib.idle_add(lambda: (invocation.return_value(GLib.Variant("(s)", (json.dumps(d, default=str),))), False)[1])
                threading.Thread(target=work, daemon=True).start()
            else:
                invocation.return_error_literal(self.Gio.dbus_error_quark(), self.Gio.DBusError.UNKNOWN_METHOD, method)
        except Exception as e:
            invocation.return_error_literal(self.Gio.dbus_error_quark(), self.Gio.DBusError.FAILED, f"{e.__class__.__name__}: {str(e)[:200]}")

    def on_get_prop(self, conn, sender, path, iface, name):
        if name == "Version":
            return self.GLib.Variant("s", VERSION)
        return None

    def run(self):
        Gio, GLib = self.Gio, self.GLib
        node = Gio.DBusNodeInfo.new_for_xml(XML)
        loop = GLib.MainLoop()

        def on_bus(conn, _name):
            self.conn = conn; self.session = conn
            reg = getattr(conn, "register_object_with_closures2", None) or conn.register_object   # the former since GLib 2.86
            self.reg_id = reg(OBJ, node.interfaces[0], self.on_call, self.on_get_prop, None)
            log(f"on the session bus as {BUS_NAME}")

        def on_lost(conn, _name):
            log("lost the bus name; another instance owns it"); loop.quit()

        Gio.bus_own_name(Gio.BusType.SESSION, BUS_NAME, Gio.BusNameOwnerFlags.NONE, on_bus, None, on_lost)
        try:
            self.watch_units()
        except Exception as e:
            log(f"no systemd watch: {str(e)[:120]}")
        threading.Thread(target=self.poll_loop, daemon=True).start()
        threading.Thread(target=self.updates_loop, daemon=True).start()
        threading.Thread(target=self.office_loop, daemon=True).start()

        def on_term():
            self.office_goodbye(); loop.quit(); return False
        import signal
        for sig in (signal.SIGTERM, signal.SIGINT, signal.SIGHUP):
            GLib.unix_signal_add(GLib.PRIORITY_HIGH, sig, on_term)
        loop.run()


def main(argv):
    if "-h" in argv or "--help" in argv:
        print(__doc__); return 0
    import gi
    gi.require_version("Gio", "2.0"); gi.require_version("GLib", "2.0")
    if "--once" in argv:
        s = Service(once=True)
        s.updates = updates_state()
        print(json.dumps(s.collect(), indent=2, default=str))
        return 0
    Service().run()
    return 0


if __name__ == "__main__":
    sys.exit(main(sys.argv[1:]))
