[Desktop Entry]
Type=Application
Name=Credential Manager
Comment=Your secrets in the MaluOS vault: add, show, rotate, delete, delegate to agents, answer requests, back up
Exec=maluos-desk --window vault
Icon=dialog-password
Terminal=false
Categories=System;Settings;Security;
Keywords=MaluOS;vault;secrets;keys;credentials;delegation;
StartupNotify=true
DBusActivatable=false
