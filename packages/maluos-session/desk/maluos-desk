#!/usr/bin/python3
"""maluos-desk: the MaluOS Desk window (GTK 4, libadwaita).

The same state the top-panel indicator shows, with room to read it: the
agents on this host (yours first) with start, stop, restart and logs; the
inference gateway, its backends and queue, your policy, budget and recent
calls; the vault (your secrets, compartments, delegations) and the grant
requests waiting for your answer; the latest alerts; the system page with
software updates (what is pending and from where, what installs on its own,
whether a restart is due) and this desk's identity. Everything comes from
maluos-desktop-session over the session bus (com.maluos.Session); this
window renders and forwards.

  maluos-desk                   open the Desk window
  maluos-desk --window updates  open the Upgrade Manager instead (slice 7): what is pending and install now,
                                the automatic-update switches (pkexec maluctl update auto …), the history,
                                this desk's release
  maluos-desk --window tools    open the Tools Installer (slice 7): the tools under /usr/share/maluos-tools
                                (maluos-tools) with their state; Install runs `maluctl tools install` in a terminal
  maluos-desk --window vault    open the Credential Manager (slice 7): your secrets, delegations, requests,
                                compartments and backup, over the vault client `maluctl secret` uses
  maluos-desk --window apps     open MaluApps (slice 7): the office's and the public catalogue (maluctl office apps)
  maluos-desk --self-test       build the window from the live state (or an empty one), print a summary, exit
"""
import json, os, subprocess, sys, threading, time

import gi
gi.require_version("Gtk", "4.0"); gi.require_version("Adw", "1")
from gi.repository import Adw, Gio, GLib, Gtk

BUS_NAME, OBJ, IFACE = "com.maluos.Session", "/com/maluos/Session", "com.maluos.Session1"
XML = """<node><interface name="com.maluos.Session1">
  <method name="GetState"><arg type="s" name="json" direction="out"/></method>
  <method name="Refresh"/>
  <method name="AgentAction"><arg type="s" name="name" direction="in"/><arg type="s" name="action" direction="in"/></method>
  <method name="RequestDecide"><arg type="i" name="id" direction="in"/><arg type="s" name="decision" direction="in"/><arg type="s" name="expires" direction="in"/><arg type="s" name="json" direction="out"/></method>
  <method name="UpdateAction"><arg type="s" name="action" direction="in"/></method>
  <method name="OfficeAction"><arg type="s" name="action" direction="in"/></method>
  <signal name="StateChanged"><arg type="s" name="json"/></signal>
</interface></node>"""


def usd(v):
    return "?" if v is None else f"${float(v):.2f}"


def hhmm(ts):
    try:
        t = time.localtime(ts if isinstance(ts, (int, float)) else time.mktime(time.strptime(str(ts)[:19], "%Y-%m-%dT%H:%M:%S")))
        return time.strftime("%H:%M", t)
    except Exception:
        return ""


def row(title, subtitle="", icon=None):
    r = Adw.ActionRow(title=GLib.markup_escape_text(str(title)), subtitle=GLib.markup_escape_text(str(subtitle)) if subtitle else "")
    if icon:
        r.add_prefix(Gtk.Image.new_from_icon_name(icon))
    return r


def button(label, cb, style=None):
    b = Gtk.Button(label=label, valign=Gtk.Align.CENTER)
    if style:
        b.add_css_class(style)
    b.connect("clicked", lambda *_: cb())
    return b


def terminal(argv):
    try:
        subprocess.Popen(["xdg-terminal-exec", *argv])
    except OSError:
        pass


class Window(Adw.ApplicationWindow):
    """The skeleton every MaluOS window shares: a view switcher over preference pages, a refresh
    button, toasts, and the calls to the session service."""
    TITLE = "MaluOS"; PAGES = (); SIZE = (820, 640)

    def __init__(self, app, proxy):
        super().__init__(application=app, title=self.TITLE, default_width=self.SIZE[0], default_height=self.SIZE[1])
        self.proxy = proxy
        self.state = None
        self.toasts = Adw.ToastOverlay()
        self.set_content(self.toasts)
        box = Gtk.Box(orientation=Gtk.Orientation.VERTICAL)
        self.toasts.set_child(box)
        header = Adw.HeaderBar()
        self.stack = Adw.ViewStack()
        switcher = Adw.ViewSwitcher(stack=self.stack, policy=Adw.ViewSwitcherPolicy.WIDE)
        header.set_title_widget(switcher)
        refresh = Gtk.Button(icon_name="view-refresh-symbolic", tooltip_text="Refresh")
        refresh.connect("clicked", lambda *_: self.proxy and self.proxy.call("Refresh", None, 0, 5000, None, None, None))
        header.pack_end(refresh)
        box.append(header)
        box.append(self.stack)
        self.pages = {}
        for name, title, icon in self.PAGES:
            page = Adw.PreferencesPage()
            self.pages[name] = page
            self.stack.add_titled_with_icon(page, name, title, icon)
        self.stack.set_vexpand(True)
        self.render()

    # -- rendering
    def clear(self, name):
        page = self.pages[name]
        for g in list(getattr(page, "_groups", [])):
            page.remove(g)
        page._groups = []

    def group(self, name, title, description=""):
        g = Adw.PreferencesGroup(title=title, description=description)
        self.pages[name].add(g); self.pages[name]._groups.append(g)
        return g

    def render(self):
        pass

    def switch(self, title, subtitle, active, cb):
        r = Adw.SwitchRow(title=GLib.markup_escape_text(str(title)), subtitle=GLib.markup_escape_text(str(subtitle)) if subtitle else "")
        r.set_active(bool(active))
        r.connect("notify::active", lambda w, _p: cb(w.get_active()))
        return r

    # -- the calls to the session service, shared by every window
    def toast(self, text):
        self.toasts.add_toast(Adw.Toast(title=text[:120]))

    def agent(self, name, action):
        if not self.proxy:
            return
        def done(proxy, res, _):
            try:
                proxy.call_finish(res)
            except Exception as e:
                self.toast(f"Agent {name}: {action} failed: {str(e)[:100]}")
        self.proxy.call("AgentAction", GLib.Variant("(ss)", (name, action)), 0, 120000, None, done, None)

    def decide(self, rid, decision, expires):
        if not self.proxy:
            return
        def done(proxy, res, _):
            try:
                proxy.call_finish(res)
                self.toast(f"Request #{rid}: {'allowed' if decision == 'approve' else 'denied'}")
            except Exception as e:
                self.toast(f"Request #{rid}: {decision} failed: {str(e)[:100]}")
        self.proxy.call("RequestDecide", GLib.Variant("(iss)", (int(rid), decision, expires)), 0, 30000, None, done, None)

    def update(self, action):
        if not self.proxy:
            return
        def done(proxy, res, _):
            try:
                proxy.call_finish(res)
            except Exception as e:
                self.toast(f"Updates: {action} failed: {str(e)[:100]}")
        self.proxy.call("UpdateAction", GLib.Variant("(s)", (action,)), 0, 30000, None, done, None)

    def office(self, action):
        if not self.proxy:
            return
        def done(proxy, res, _):
            try:
                proxy.call_finish(res)
                if action == "heartbeat":
                    self.toast("Checking in with the office…")
            except Exception as e:
                self.toast(f"Office: {action} failed: {str(e)[:100]}")
        self.proxy.call("OfficeAction", GLib.Variant("(s)", (action,)), 0, 30000, None, done, None)

    def set_state(self, text):
        try:
            self.state = json.loads(text) if text else None
        except ValueError:
            self.state = None
        self.render()


class Desk(Window):
    TITLE = "MaluOS Desk"
    PAGES = (("agents", "Agents", "system-run-symbolic"), ("models", "Models", "network-server-symbolic"),
             ("vault", "Vault", "dialog-password-symbolic"), ("alerts", "Alerts", "dialog-warning-symbolic"),
             ("system", "System", "software-update-available-symbolic"))

    def render(self):
        s = self.state
        for n in self.pages:
            self.clear(n)
        if not s:
            self.group("agents", "MaluOS Desk", "The session service (maluos-desktop-session) is not running or not reachable.")
            return
        h = s.get("host") or {}
        self.set_title(f"MaluOS Desk · {h.get('hostname', '')}")
        self.render_agents(s); self.render_models(s); self.render_vault(s); self.render_alerts(s); self.render_system(s)

    def render_agents(self, s):
        agents = sorted(s.get("agents") or [], key=lambda a: (not a.get("mine"), a["name"]))
        mine = [a for a in agents if a.get("mine")]; others = [a for a in agents if not a.get("mine")]
        if not agents:
            self.group("agents", "Agents", "No agents on this host. Create one with: sudo maluctl agent create NAME --exec CMD")
        for title, lst, desc in (("Your agents", mine, "You may start and stop these without an administrator's password."),
                                 ("Other agents on this host", others, "")):
            if not lst:
                continue
            g = self.group("agents", title, desc)
            for a in lst:
                st = a.get("active", "inactive"); sub = a.get("sub") or ""
                icon = {"active": "emblem-ok-symbolic", "failed": "dialog-error-symbolic"}.get(st, "media-playback-stop-symbolic")
                r = row(a["name"], f"{st}{' (' + sub + ')' if sub and sub not in ('dead', 'running') else ''} · {a.get('principal')}"
                        + (f" · owner {a['owner']}" if a.get("owner") and not a.get("mine") else "")
                        + (" · strict sandbox" if a.get("sandbox") == "strict" else "") + (f"\n{a['exec']}" if a.get("exec") else ""), icon)
                if st == "active":
                    r.add_suffix(button("Stop", lambda n=a["name"]: self.agent(n, "stop")))
                    r.add_suffix(button("Restart", lambda n=a["name"]: self.agent(n, "restart")))
                else:
                    r.add_suffix(button("Start", lambda n=a["name"]: self.agent(n, "start"), "suggested-action"))
                r.add_suffix(button("Logs", lambda u=a["unit"]: terminal(["sh", "-c", f"journalctl -f -u {u} || sudo journalctl -f -u {u}"])))
                g.add(r)

    def render_models(self, s):
        g = s.get("gateway") or {}; me = s.get("me") or {}; h = s.get("host") or {}
        if not g.get("available"):
            self.group("models", "Inference gateway", "Not available on this host."); return
        q = g.get("queue") or {}
        backends = g.get("backends") or []
        grp = self.group("models", "Inference gateway", f"version {g.get('version') or '?'} · {q.get('queued', 0)} queued, {q.get('running', 0)} running · {sum(1 for b in backends if b.get('healthy'))}/{len(backends)} backends healthy")
        for b in backends:
            grp.add(row(b.get("name"), f"{'cloud' if b.get('cloud') else 'local'} · {'healthy' if b.get('healthy') else 'down'}"
                        + (" · " + ", ".join(b["loaded"]) if b.get("loaded") else "") + (f" · {b['error']}" if b.get("error") else ""),
                        "emblem-ok-symbolic" if b.get("healthy") else "dialog-error-symbolic"))
        who = me.get("principal") or f"user:{h.get('user')}"
        grp = self.group("models", "You", f"{who}{' · operator' if me.get('operator') else ''}{'' if me.get('enrolled') else ' · not enrolled as a principal'}")
        pol = me.get("policy") or {}
        if pol:
            grp.add(row("Policy", ", ".join(f"{k} {v}" for k, v in pol.items())))
        for period, b in (me.get("budget") or {}).items():
            level = "" if b.get("spent") is None else " · exhausted" if b["spent"] >= b["limit"] else " · nearly used" if b["spent"] >= b.get("warn_at", 0.8) * b["limit"] else ""
            grp.add(row(f"Budget this {period}", f"{usd(b.get('spent'))} of {usd(b.get('limit'))}{level}"))
        recent = me.get("recent") or []
        if recent:
            grp = self.group("models", "Recent calls")
            for c in recent:
                grp.add(row(f"{hhmm(c.get('ts'))}  {c.get('requested') or '?'} → {c.get('backend') or '-'}/{c.get('model') or '-'}",
                            f"{c.get('status') or ''}{' · ' + c['reason'] if c.get('reason') else ''}{' · class ' + c['class'] if c.get('class') else ''}"))

    def render_vault(self, s):
        v = s.get("vault") or {}
        if not v.get("available"):
            self.group("vault", "Vault", "Not available on this host."); return
        if not v.get("enrolled"):
            self.group("vault", "Vault", "You are not enrolled as a principal."); return
        asks = [r for r in v.get("requests") or [] if r.get("mine_to_decide")]
        if asks:
            grp = self.group("vault", "Requests for your secrets", "An agent or a person was refused one of your secrets and asks for a grant.")
            for r in asks:
                who = r.get("requester") or "?"
                rr = row(f"{who} asks for {r.get('secret')}", f"{r.get('level')} access{' · ' + r['purpose'] if r.get('purpose') else ''}"
                         + (f" · asked {r['asked_count']} times" if (r.get("asked_count") or 1) > 1 else "") + (f" · {r['process']}" if r.get("process") else ""), "dialog-question-symbolic")
                rr.add_suffix(button("Allow for a week", lambda i=r["id"]: self.decide(i, "approve", "7d"), "suggested-action"))
                rr.add_suffix(button("Deny", lambda i=r["id"]: self.decide(i, "deny", ""), "destructive-action"))
                grp.add(rr)
        grp = self.group("vault", "Your vault", f"{v.get('principal')} · {v.get('secrets', 0)} secrets · maluctl secret list")
        for c in v.get("compartments") or []:
            grp.add(row(c, "compartment", "folder-symbolic"))
        dels = v.get("delegations") or []
        if dels:
            grp = self.group("vault", "Delegations", "Agents that may use your keys (use only, never read).")
            for d in dels:
                grp.add(row(f"{d.get('secret') or 'all secrets'} → {d.get('to')}", f"until {d['expires_at'][:10]}" if d.get("expires_at") else "no expiry"))
        mine_asks = [r for r in v.get("requests") or [] if not r.get("mine_to_decide")]
        if mine_asks:
            grp = self.group("vault", "Your pending requests")
            for r in mine_asks:
                grp.add(row(r.get("secret"), f"{r.get('level')} access, waiting for the owner"))

    def render_alerts(self, s):
        alerts = s.get("alerts") or []
        if not alerts:
            self.group("alerts", "Alerts", "Nothing recent."); return
        grp = self.group("alerts", "Alerts", "From the ledger: budgets, backends, anomalies, restarts.")
        for a in alerts[:30]:
            grp.add(row(f"{(a.get('ts') or '')[11:16]}  {a.get('kind')}", a.get("title") or "", "dialog-warning-symbolic"))

    def render_system(self, s):
        h = s.get("host") or {}; u = s.get("updates") or {}
        grp = self.group("system", "This desk", f"{h.get('pretty_name', 'MaluOS')} · {h.get('hostname', '')}")
        mem = h.get("memory")
        grp.add(row("Memory host", f"tenant {mem.get('tenant')} on this desk" if mem else "not provisioned on this desk", "drive-harddisk-symbolic"))
        self.render_office(s)
        if not u.get("available"):
            self.group("system", "Software updates", f"Not readable: {u.get('error') or 'maluctl update is not installed'}"); return
        manual = u.get("manual_count", (u.get("pending_count") or 0) - (u.get("automatic_count") or 0))
        if u.get("reboot_required"):
            pk = u.get("reboot_packages") or []
            desc = "A restart finishes the installed updates" + (f" ({', '.join(pk[:6])})" if pk else "") + "."
        elif u.get("pending_error"):
            desc = f"Pending updates unknown right now: {u['pending_error']}."
        elif not u.get("pending_count"):
            desc = f"Up to date as of the last refresh ({u.get('lists_refreshed') or '?'})."
        else:
            desc = f"{u['pending_count']} pending · {u.get('security_count', 0)} security · {u.get('automatic_count', 0)} install on their own · {manual} wait for you."
        grp = self.group("system", "Software updates", desc)
        r = row("Updates", "GNOME Software installs them; `maluctl update` does the same from a terminal", "software-update-available-symbolic")
        if u.get("pending_count"):
            r.add_suffix(button("Install…", lambda: self.update("open"), "suggested-action"))
        if u.get("reboot_required"):
            r.add_suffix(button("Restart now", lambda: self.update("restart"), "destructive-action"))
        r.add_suffix(button("Check again", lambda: self.update("refresh")))
        grp.add(r)
        a = u.get("automatic") or {}
        grp.add(row("Automatic updates", ("on" if a.get("enabled") else "off") + f" · last run {u.get('last_automatic_run') or 'never'}"
                    + (f" · next {a['next_run']}" if a.get("next_run") and a["next_run"] != "n/a" else "")
                    + ("\n" + ", ".join(a.get("origins") or []) if a.get("origins") else ""), "alarm-symbolic"))
        pending = u.get("pending") or []
        if pending:
            grp = self.group("system", "Pending", "Where each update comes from, and whether it installs on its own.")
            for p in pending[:40]:
                grp.add(row(p.get("name"), f"{p.get('installed') or '-'} → {p.get('candidate')} · {p.get('source')}"
                            + (" · security" if p.get("security") and p.get("source") != "security" else "") + ("" if p.get("automatic") else " · waits for you"),
                            "security-high-symbolic" if p.get("security") else "package-x-generic-symbolic"))
            if len(pending) > 40:
                grp.add(row(f"… and {len(pending) - 40} more", "maluctl update status lists them all"))

    def render_office(self, s):
        o = s.get("office") or {}
        if not o.get("enrolled"):
            self.group("system", "Office", "This desk is not enrolled with a Business OS office. From a terminal: sudo maluctl office enroll URL --code CODE (the office shows the code once).")
            return
        name = (o.get("office") or {}).get("name") or o.get("url")
        pres = {"retired": "retired by the office", "online": "online", "unreachable": "unreachable", "unknown": "checking in…"}.get(o.get("presence"), o.get("presence"))
        d, w = o.get("desk") or {}, o.get("owner") or {}
        grp = self.group("system", "Office", f"{name} · desk {d.get('name') or '?'} (#{d.get('id') or '?'}) · {pres}"
                         + (f" · last check-in {o['last_heartbeat_at']}" if o.get("last_heartbeat_at") else "") + (f"\n{o['last_error']}" if o.get("last_error") else ""))
        r = row("This desk", f"{w.get('display_name') or w.get('principal') or 'you'}" + (f" <{w['email']}>" if w.get("email") else "") + f" · {o.get('url')}",
                "network-workgroup-symbolic" if o.get("ok") else "network-offline-symbolic")
        r.add_suffix(button("Open office…", lambda: self.office("open")))
        r.add_suffix(button("Check in now", lambda: self.office("heartbeat")))
        grp.add(r)
        eps = [k for k, v in (o.get("endpoints") or {}).items() if k != "models" and v]
        models = (o.get("endpoints") or {}).get("models")
        grp.add(row("Published to desks", (", ".join(eps) or "nothing") + (f" · models {', '.join(models)}" if models else " · no models") + (f" · --model {o['gateway']} on this desk's gateway" if o.get("gateway") else ""), "network-server-symbolic"))
        grp.add(row("Agents", "the office's endpoints are in /etc/maluos/office.env; delegate the token: maluctl secret delegate --to agent:NAME --secret office-desk-token", "system-run-symbolic"))
        if o.get("revoked"):
            grp.add(row("Retired", "the office no longer accepts this desk's token; sudo maluctl office leave removes the enrolment", "dialog-warning-symbolic"))




class UpgradeManager(Window):
    """Slice 7: software updates in one place. Updates (pending, install now), Automatic (the
    switches: on/off, per origin, restart), History, Release. The switches call UpdateAction
    auto:… on the session service, which runs `pkexec maluctl update auto …`; the outcome comes
    back as updates.last_action and the switches are re-read from the state."""
    TITLE = "Upgrade Manager"; SIZE = (780, 600)
    PAGES = (("updates", "Updates", "software-update-available-symbolic"), ("automatic", "Automatic", "alarm-symbolic"),
             ("history", "History", "document-open-recent-symbolic"), ("release", "Release", "emblem-system-symbolic"))
    ORIGINS = (("security", "Ubuntu security updates", "the resolute-security pocket of the Ubuntu archive"),
               ("maluos", "MaluOS updates", "apt.maluos.com: the MaluOS packages, the kernel and the applications"),
               ("mozilla", "Firefox from Mozilla", "packages.mozilla.org"))

    def __init__(self, app, proxy):
        self.history_text = None; self.history_loading = False; self.seen_action = "first"; self.reboot_at = None
        super().__init__(app, proxy)

    def render(self):
        s = self.state
        for n in self.pages:
            self.clear(n)
        if not s:
            self.group("updates", "Upgrade Manager", "The session service (maluos-desktop-session) is not running or not reachable.")
            return
        u = s.get("updates") or {}
        self.set_title(f"Upgrade Manager · {(s.get('host') or {}).get('hostname', '')}")
        la = u.get("last_action")
        if la and la.get("ts") != self.seen_action:
            if self.seen_action != "first":
                self.toast("Automatic updates changed" if la.get("ok") else f"Could not change automatic updates: {la.get('error') or 'refused'}")
            self.seen_action = la.get("ts")
        elif self.seen_action == "first":
            self.seen_action = None
        self.render_updates(s, u); self.render_automatic(u); self.render_history(u); self.render_release(s)

    def render_updates(self, s, u):
        if not u.get("available"):
            self.group("updates", "Software updates", f"Not readable: {u.get('error') or 'maluctl update is not installed'}"); return
        manual = u.get("manual_count", (u.get("pending_count") or 0) - (u.get("automatic_count") or 0))
        if u.get("reboot_required"):
            pk = u.get("reboot_packages") or []
            desc = "A restart finishes the installed updates" + (f" ({', '.join(pk[:6])})" if pk else "") + "."
        elif u.get("pending_error"):
            desc = f"Pending updates unknown right now: {u['pending_error']}."
        elif not u.get("pending_count"):
            desc = f"Up to date as of the last refresh ({u.get('lists_refreshed') or '?'})."
        else:
            desc = f"{u['pending_count']} pending · {u.get('security_count', 0)} security · {u.get('automatic_count', 0)} covered by the automatic policy · {manual} wait for you."
        grp = self.group("updates", "Software updates", desc + (" Reading…" if u.get("reading") else ""))
        r = row("Install", "Update now installs what the automatic policy covers; Update everything installs every pending update (apt-get full-upgrade). Both open a terminal with apt's log and ask for an administrator's password.", "software-update-available-symbolic")
        if u.get("automatic_count"):
            r.add_suffix(button("Update now", lambda: self.update("apply"), "suggested-action"))
        if u.get("pending_count"):
            r.add_suffix(button("Update everything", lambda: self.update("apply-all")))
        if u.get("reboot_required"):
            r.add_suffix(button("Restart now", lambda: self.update("restart"), "destructive-action"))
        r.add_suffix(button("Check again", lambda: self.update("refresh")))
        grp.add(r)
        by = u.get("by_source") or {}
        if by:
            grp.add(row("From", " · ".join(f"{k} {v}" for k, v in sorted(by.items())), "network-server-symbolic"))
        pending = u.get("pending") or []
        if pending:
            grp = self.group("updates", "Pending", "Where each update comes from, and whether the automatic policy covers it.")
            for p in pending[:60]:
                grp.add(row(p.get("name"), f"{p.get('installed') or '-'} → {p.get('candidate')} · {p.get('source')}"
                            + (" · security" if p.get("security") and p.get("source") != "security" else "") + ("" if p.get("automatic") else " · waits for you"),
