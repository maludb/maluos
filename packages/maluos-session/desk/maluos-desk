class CredentialManager(Window):
    """Slice 7: the vault's full user side, over the same client library and API `maluctl secret`
    uses (/usr/lib/maluos/maluos_vault_client.py, the vault socket as this user, peer credentials).
    Secrets (list, add, show, rotate, delete), Delegations (delegate, undelegate), Requests (approve,
    deny, your own), Compartments, Backup (export and import run `maluctl secret` in a terminal for
    the passphrase prompts). Every button is one verb of the CLI, so policy and audit are the same."""
    TITLE = "Credential Manager"; SIZE = (820, 620)
    PAGES = (("secrets", "Secrets", "dialog-password-symbolic"), ("delegations", "Delegations", "system-users-symbolic"),
             ("requests", "Requests", "dialog-question-symbolic"), ("compartments", "Compartments", "folder-symbolic"),
             ("backup", "Backup", "drive-harddisk-symbolic"))

    def __init__(self, app, proxy):
        self.vault = None; self.data = None; self.loading = False; self.error = None
        super().__init__(app, proxy)
        GLib.timeout_add_seconds(30, self.poll)

    def client(self):
        if self.vault is None:
            sys.path.insert(0, "/usr/lib/maluos")
            import maluos_vault_client
            self.vault = maluos_vault_client.VaultClient(timeout=20)
        return self.vault

    def poll(self):
        if not self.loading:
            self.load()
        return True

    def load(self):
        self.loading = True
        def run():
            d, err = None, None
            try:
                v = self.client()
                who = v.whoami()
                d = {"who": who, "secrets": v.secrets() if who.get("enrolled") else [], "delegations": v.delegations() if who.get("enrolled") else [],
                     "requests": v.requests("pending") if who.get("enrolled") else [], "compartments": v.compartments() if who.get("enrolled") else []}
            except Exception as e:
                err = f"{e.__class__.__name__}: {str(e)[:160]}"
            GLib.idle_add(self.set_data, d, err)
        threading.Thread(target=run, daemon=True).start()

    def set_data(self, d, err):
        self.data = d; self.error = err; self.loading = False
        self.render(); return False

    def set_state(self, text):
        super().set_state(text)

    # -- rendering
    def render(self):
        for n in self.pages:
            self.clear(n)
        h = (self.state or {}).get("host") or {}
        self.set_title(f"Credential Manager · {h.get('hostname', '')}")
        if self.data is None:
            if not self.loading and not self.error:
                self.load()
            self.group("secrets", "Vault", self.error or "Reading your vault…"); return
        who = self.data["who"]
        if not who.get("enrolled"):
            self.group("secrets", "Vault", "You are not enrolled as a principal in this desk's vault; an operator enrols you (maluctl secret whoami)."); return
        self.render_secrets(who); self.render_delegations(); self.render_requests(); self.render_compartments(); self.render_backup()

    def render_secrets(self, who):
        secs = self.data["secrets"]
        grp = self.group("secrets", "Your secrets", f"{who.get('principal')} · {len(secs)} secrets · maluctl secret list" + (f" · {self.error}" if self.error else ""))
        r = row("Add a secret", "a name, a kind (api-key, token, password…) and the value; the value is never shown again except with Show", "list-add-symbolic")
        r.add_suffix(button("Add…", self.add_dialog, "suggested-action")); r.add_suffix(button("Read again", self.load)); grp.add(r)
        for sct in sorted(secs, key=lambda x: x.get("ref") or x.get("name") or ""):
            ref = sct.get("ref") or sct.get("name")
            acc = (sct.get("access") or {}).get("level") if isinstance(sct.get("access"), dict) else sct.get("access")
            sub = f"{sct.get('kind') or 'secret'}{' · ' + sct['provider'] if sct.get('provider') else ''}{' · $' + sct['env_var'] if sct.get('env_var') else ''}"
            sub += f" · access {acc or '-'}" + (f" · expires {sct['expires_at'][:10]}" if sct.get("expires_at") else "") + (" · locked" if sct.get("locked") else "")
            sub += (f" · created {sct['created_at'][:10]}" if sct.get("created_at") else "") + (f" · rotated {sct['rotated_at'][:10]}" if sct.get("rotated_at") else "")
            rr = row(ref, sub, "dialog-password-symbolic")
            mine = sct.get("compartment") == who.get("principal") or acc in ("owner", "read", "admin")
            if mine:
                rr.add_suffix(button("Show", lambda n=ref: self.show_dialog(n)))
                rr.add_suffix(button("Rotate", lambda n=ref: self.rotate_dialog(n)))
                rr.add_suffix(button("Delete", lambda n=ref: self.delete_dialog(n), "destructive-action"))
            grp.add(rr)
        if not secs:
            grp.add(row("No secrets yet", "Add one here, or from a terminal: maluctl secret add NAME --kind api-key"))

    def render_delegations(self):
        dels = self.data["delegations"]
        grp = self.group("delegations", "Delegations", "Who may use your keys: agents get use-only access (the gateway applies the key, the agent never reads it), with an expiry and a budget. maluctl secret delegate")
        r = row("Delegate a key", "to an agent on this desk (agent:NAME) or a person, one secret or all, for a time, within a budget", "list-add-symbolic")
