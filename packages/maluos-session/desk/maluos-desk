        self.form("Add a secret", "Stored in your compartment; agents use it only through a delegation.",
                  [("name", "Name", "", False), ("kind", "Kind", "api-key", False), ("provider", "Provider (optional)", "", False),
                   ("env", "Environment variable (optional)", "", False), ("expires", "Expires (optional, e.g. 90d)", "", False), ("value", "Value", "", True)], ok, "Add")

