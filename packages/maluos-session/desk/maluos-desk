            grp.add(row("No delegations", "Agents cannot use your keys until you delegate one."))

    def render_requests(self):
        reqs = self.data["requests"]
        me = (self.data["who"] or {}).get("principal")
        asks = [r for r in reqs if r.get("owner") == me]
        mine = [r for r in reqs if r.get("requester") == me]
        grp = self.group("requests", "Requests for your secrets", "An agent or a person was refused one of your secrets and asks for a grant. Approve for a week, a day, or deny. maluctl secret requests")
        for r in asks:
            rid = r.get("request_id") or r.get("id")
            rr = row(f"{r.get('requester') or '?'} asks for {r.get('secret')}", f"{r.get('level')} access{' · ' + r['purpose'] if r.get('purpose') else ''}" + (f" · {r['process']}" if r.get("process") else "") + (f" · asked {r['asked_count']} times" if (r.get("asked_count") or 1) > 1 else ""), "dialog-question-symbolic")
            rr.add_suffix(button("Allow for a week", lambda i=rid: self.act("approve", lambda v: v.approve(i, expires_at="7d"), f"request #{i} allowed for a week"), "suggested-action"))
            rr.add_suffix(button("Allow for a day", lambda i=rid: self.act("approve", lambda v: v.approve(i, expires_at="1d"), f"request #{i} allowed for a day")))
            rr.add_suffix(button("Deny", lambda i=rid: self.act("deny", lambda v: v.deny_request(i), f"request #{i} denied"), "destructive-action"))
            grp.add(rr)
        if not asks:
            grp.add(row("Nothing waiting for you", "Requests also arrive as notifications with Allow and Deny."))
        if mine:
            grp = self.group("requests", "Your own requests", "Waiting for the owner's answer.")
            for r in mine:
                grp.add(row(r.get("secret"), f"{r.get('level')} access" + (f" · {r['purpose']}" if r.get("purpose") else "")))

    def render_compartments(self):
        comps = self.data["compartments"]
        grp = self.group("compartments", "Compartments", "Yours, and the agents' you own: each agent keeps its own secrets in its own compartment (maluctl secret as the agent manages them). maluctl secret compartment")
        for c in comps:
            grp.add(row(c.get("name"), f"owner {c.get('owner') or '-'}" + (f" · scope {c['scope']}" if c.get("scope") else "") + (" · locked" if c.get("locked") else "") + (f" · {c['secrets']} secrets" if c.get("secrets") is not None else ""), "folder-symbolic"))
        if not comps:
            grp.add(row("No compartments visible", ""))

    def render_backup(self):
        grp = self.group("backup", "Backup", "Export your vault to a passphrase-protected file, or import one. Both run maluctl secret in a terminal, which asks for the passphrase (never typed into this window).")
