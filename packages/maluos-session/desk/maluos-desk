    # -- actions, each one CLI verb
    def act(self, what, fn, done_text):
        def run():
            try:
                fn(self.client()); msg = done_text
            except Exception as e:
                msg = f"{what} failed: {getattr(e, 'message', None) or str(e)[:120]}"
            GLib.idle_add(lambda: (self.toast(msg), self.load()) and False)
        threading.Thread(target=run, daemon=True).start()

    def form(self, heading, body, fields, on_ok, ok_label="OK", destructive=False):
        """An AlertDialog with labelled entries; FIELDS = [(key, label, placeholder, hidden)]."""
        dlg = Adw.AlertDialog(heading=heading, body=body)
        box = Gtk.Box(orientation=Gtk.Orientation.VERTICAL, spacing=6)
        entries = {}
        for key, label, placeholder, hidden in fields:
            e = Adw.PasswordEntryRow(title=label) if hidden else Adw.EntryRow(title=label)
            if placeholder and not hidden:
                e.set_text(placeholder)
            entries[key] = e
            lb = Gtk.ListBox(css_classes=["boxed-list"]); lb.append(e); box.append(lb)
        dlg.set_extra_child(box)
        dlg.add_response("cancel", "Cancel"); dlg.add_response("ok", ok_label)
        dlg.set_response_appearance("ok", Adw.ResponseAppearance.DESTRUCTIVE if destructive else Adw.ResponseAppearance.SUGGESTED)
        dlg.set_default_response("ok"); dlg.set_close_response("cancel")
        def on_resp(_d, resp):
            if resp == "ok":
                on_ok({k: e.get_text().strip() for k, e in entries.items()})
        dlg.connect("response", on_resp)
        dlg.present(self)

