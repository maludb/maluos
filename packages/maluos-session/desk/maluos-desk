        return False

    def delegate_dialog(self):
        agents = [a["principal"] for a in (self.state or {}).get("agents") or [] if a.get("principal")]
        def ok(f):
            if not f["to"]:
                self.toast("A principal is needed (agent:NAME)"); return
            budget = None
            if f["budget"]:
                try:
                    budget = {"usd_per_day": float(f["budget"])}
                except ValueError:
                    self.toast("Budget is dollars per day, a number"); return
            self.act("delegate", lambda v: v.delegate(f["to"], secret=f["secret"] or None, expires_at=f["expires"] or None, budget=budget), f"delegated {f['secret'] or 'all secrets'} to {f['to']}")
        self.form("Delegate a key", "Use only: the gateway applies the key for the agent, which never reads it." + (f" Agents here: {', '.join(agents[:6])}" if agents else ""),
                  [("to", "To (principal, e.g. agent:research)", agents[0] if agents else "agent:", False), ("secret", "Secret (empty = all your secrets)", "", False),
                   ("expires", "Expires (e.g. 7d)", "7d", False), ("budget", "Budget, USD per day (optional)", "", False)], ok, "Delegate")


class MaluApps(Window):
    """Slice 7: MaluApps. The catalogue from `maluctl office apps --json` (the office's apps over the
    public list, cached); Install makes a web app a launcher in its own Firefox window or installs
    a deb app in a terminal; Open starts it; Remove takes the launcher away."""
    TITLE = "MaluApps"; SIZE = (780, 580)
    PAGES = (("apps", "Apps", "view-grid-symbolic"),)

    def __init__(self, app, proxy):
        self.cat = None; self.loading = False
        super().__init__(app, proxy)
        GLib.timeout_add_seconds(60, self.poll)

    def poll(self):
        if not self.loading:
            self.load(refresh=True)
        return True

    def load(self, refresh=False):
        self.loading = True
        def run():
            try:
                r = subprocess.run(["maluctl", "office", "apps", "--json", "--compact"] + (["--refresh"] if refresh else []), capture_output=True, text=True, timeout=90)
                cat = json.loads(r.stdout) if r.stdout.strip() else {"apps": [], "errors": [r.stderr.strip()[:160]]}
            except Exception as e:
                cat = {"apps": [], "errors": [f"{e.__class__.__name__}: {str(e)[:120]}"]}
            GLib.idle_add(self.set_cat, cat)
        threading.Thread(target=run, daemon=True).start()

    def set_cat(self, cat):
        self.cat = cat; self.loading = False
        self.render(); return False

    def render(self):
        for n in self.pages:
            self.clear(n)
        h = (self.state or {}).get("host") or {}
        self.set_title(f"MaluApps · {h.get('hostname', '')}")
        if self.cat is None:
            if not self.loading:
                self.load()
            self.group("apps", "MaluApps", "Reading the catalogue…"); return
        cat = self.cat; apps = cat.get("apps") or []
        src = f"from {cat['office']}" if cat.get("office") else "the public catalogue (enrol this desk with an office for its own apps)"
        desc = f"Applications for this desk, {src}" + (" · cached, the sources were unreachable" if cat.get("stale") else "") + (" · " + "; ".join(cat["errors"]) if cat.get("errors") and not apps else "") + ". A web app opens in its own Firefox window; a deb app installs from the MaluOS repository."
        grp = self.group("apps", "MaluApps", desc)
        r = row("Read again", "the catalogue is re-read every minute while this window is open", "view-refresh-symbolic")
        r.add_suffix(button("Read again", lambda: self.load(refresh=True))); grp.add(r)
        for a in apps:
            state = "installed" if a.get("installed") else ("available" if a.get("available") else a.get("reason") or "not available")
            rr = row(a.get("name") or a["id"], f"{state} · {a.get('kind')} · {a.get('source')} · {a.get('description', '')}" + (f"\n{a['url']}" if a.get("url") else ""), a.get("icon") or "application-x-executable")
            if a.get("installed"):
                rr.add_suffix(button("Open", lambda i=a["id"]: subprocess.Popen(["maluctl", "office", "apps", "open", i], stdin=subprocess.DEVNULL, stdout=subprocess.DEVNULL, stderr=subprocess.DEVNULL), "suggested-action"))
                rr.add_suffix(button("Remove", lambda i=a["id"]: self.run_cli(["remove", i]), "destructive-action"))
            elif a.get("available"):
                if a.get("kind") == "deb":
                    rr.add_suffix(button("Install", lambda i=a["id"]: terminal(["sh", "-c", f"maluctl office apps install {i}; echo; echo '--- press Enter to close'; read _"]), "suggested-action"))
                else:
                    rr.add_suffix(button("Install", lambda i=a["id"]: self.run_cli(["install", i]), "suggested-action"))
            grp.add(rr)
        if not apps:
            grp.add(row("No apps listed", "The office publishes none yet, and the public catalogue could not be read."))

    def run_cli(self, argv):
        def run():
            r = subprocess.run(["maluctl", "office", "apps", *argv], capture_output=True, text=True, timeout=120)
            msg = (r.stdout.strip() or r.stderr.strip()).splitlines()[-1][:120] if (r.stdout.strip() or r.stderr.strip()) else ("done" if r.returncode == 0 else "failed")
            GLib.idle_add(lambda: (self.toast(msg), self.load()) and False)
        threading.Thread(target=run, daemon=True).start()


WINDOWS = {"desk": ("com.maluos.Desk", Desk), "updates": ("com.maluos.UpgradeManager", UpgradeManager), "tools": ("com.maluos.ToolsInstaller", ToolsInstaller),
           "vault": ("com.maluos.CredentialManager", CredentialManager), "apps": ("com.maluos.MaluApps", MaluApps)}


class App(Adw.Application):
    def __init__(self, window="desk", self_test=False):
        app_id, self.window_class = WINDOWS[window]
        super().__init__(application_id=app_id, flags=Gio.ApplicationFlags.NON_UNIQUE if self_test else Gio.ApplicationFlags.DEFAULT_FLAGS)
        self.self_test = self_test
        self.proxy = None
        self.win = None

    def do_activate(self):
        if self.win:
            self.win.present(); return
        try:
            node = Gio.DBusNodeInfo.new_for_xml(XML)
            self.proxy = Gio.DBusProxy.new_for_bus_sync(Gio.BusType.SESSION, Gio.DBusProxyFlags.NONE, node.interfaces[0], BUS_NAME, OBJ, IFACE, None)
            self.proxy.connect("g-signal", lambda _p, _s, sig, params: sig == "StateChanged" and self.win and self.win.set_state(params.unpack()[0]))
        except Exception as e:
            print(f"maluos-desk: no session bus or service: {e}", file=sys.stderr); self.proxy = None
        self.win = self.window_class(self, self.proxy)
        if self.proxy:
            try:
                self.win.set_state(self.proxy.call_sync("GetState", None, 0, 10000, None).unpack()[0])
            except Exception as e:
                print(f"maluos-desk: GetState: {e}", file=sys.stderr); self.win.set_state(None)
        self.win.present()
        if self.self_test:
            def report():
                s = self.win.state or {}
                o = s.get("office") or {}
                u = s.get("updates") or {}
                print(f"self-test ok: {self.win.TITLE}: service {'reachable' if s else 'unreachable'}, {len(s.get('agents') or [])} agents, "
                      f"{len((s.get('vault') or {}).get('requests') or [])} requests, pages {', '.join(self.win.pages)}, "
                      + (f"office {(o.get('office') or {}).get('name') or o.get('url')} ({o.get('presence')})" if o.get("enrolled") else "no office")
                      + (f", automatic updates {'on' if (u.get('automatic') or {}).get('enabled') else 'off'}" if u.get("available") else ""))
                self.quit(); return False
            GLib.timeout_add(1500, report)


def main(argv):
    if "-h" in argv or "--help" in argv:
        print(__doc__); return 0
    window = "desk"
    if "--window" in argv:
        window = argv[argv.index("--window") + 1]
        if window not in WINDOWS:
            print(f"maluos-desk: --window takes {', '.join(WINDOWS)}", file=sys.stderr); return 2
    app = App(window=window, self_test="--self-test" in argv)
    return app.run([a for a in argv if a not in ("--self-test", "--window", window)])


if __name__ == "__main__":
    sys.exit(main(sys.argv))
