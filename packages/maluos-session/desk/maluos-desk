            rr = row(f"{sec} → {to}", sub, "system-users-symbolic")
            rr.add_suffix(button("Undelegate", lambda t=to, s2=(d.get("secret") or d.get("secret_name")): self.act("undelegate", lambda v: v.undelegate(t, secret=s2), f"undelegated {s2 or 'all'} from {t}"), "destructive-action"))
            grp.add(rr)
