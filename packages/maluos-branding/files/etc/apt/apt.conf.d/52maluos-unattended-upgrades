// MaluOS: with ID=maluos in os-release, ${distro_id} no longer matches the
// Ubuntu archive, so name the origins explicitly. Security from the base
// archive, everything from the MaluOS repository, and Firefox from Mozilla's
// repository (its Origin field is an opaque registry path, so match the site).
Unattended-Upgrade::Allowed-Origins {
    "Ubuntu:resolute-security";
    "UbuntuESMApps:resolute-apps-security";
    "UbuntuESM:resolute-infra-security";
    "MaluOS:resolute";
};
Unattended-Upgrade::Origins-Pattern {
    "site=packages.mozilla.org";
};
