# MaluOS desktop identity. Later than ubuntu-settings' 10_ file, so it wins.
[org.gnome.desktop.background:GNOME-Greeter]
picture-uri = 'file:///usr/share/backgrounds/maluos/maluos-dark.png'
picture-uri-dark = 'file:///usr/share/backgrounds/maluos/maluos-dark.png'

[org.gnome.login-screen]
logo = '/usr/share/pixmaps/maluos-logo-text.png'

[org.gnome.desktop.background:ubuntu]
picture-uri = 'file:///usr/share/backgrounds/maluos/maluos-light.png'
picture-uri-dark = 'file:///usr/share/backgrounds/maluos/maluos-dark.png'
picture-options = 'zoom'

[org.gnome.desktop.screensaver:ubuntu]
picture-uri = 'file:///usr/share/backgrounds/maluos/maluos-dark.png'

# Power (Phase 12 slice 7): a desk runs agents, gateway calls and office heartbeats; a
# suspended desk ends them all. Automatic Screen Blank and Automatic Suspend are off by
# default in the session and on the login screen (GDM suspends an idle greeter after
# 20 min on its own). Defaults, not locks: Settings → Power changes them per user.
[org.gnome.desktop.session:ubuntu]
idle-delay = uint32 0

[org.gnome.settings-daemon.plugins.power:ubuntu]
sleep-inactive-ac-type = 'nothing'
sleep-inactive-battery-type = 'nothing'

[org.gnome.settings-daemon.plugins.power:GNOME-Greeter]
sleep-inactive-ac-type = 'nothing'
sleep-inactive-battery-type = 'nothing'
