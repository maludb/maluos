#!/usr/bin/python3
"""maluctl: MaluOS system tool.

  maluctl status                      provisioning, database, tenant, listener
  maluctl token [rotate]              print (or rotate) the MCP listener bearer token
  maluctl token api                   print the tenant's MaluDB API token
  maluctl principal list              principals in the tenant
  maluctl principal add REF [--kind agent|human] [--name NAME] [--home SCOPE]
  maluctl provision [--force]         (re)run first-boot provisioning now
  maluctl firstboot status            the same as status (the installer's enrolment line included)
  maluctl db status                   where the data is: this host's cluster, or the estate's database server
  maluctl db psql [DATABASE] [ARGS]   a psql session there (the local superuser, or the database server's admin role)
  maluctl db export DIR               on a database server: the admin credential and the certificate, for an office's plan
  maluctl <plugin> ...                subcommands from /usr/lib/maluos/maluctl.d (e.g. secret)
"""
import json, os, secrets, subprocess, sys, urllib.request
sys.path.insert(0, "/usr/lib/maluos")
import maluos_provision as mp


def need_root():
    if os.geteuid() != 0:
        sys.exit("maluctl: run with sudo")


def state():
    return json.load(open(mp.DONE)) if os.path.exists(mp.DONE) else None


def cmd_status(_):
    st = state()
    if not st:
        print("provisioned: no  (systemctl status maluos-firstboot)"); return 1
    print(f"provisioned: {st['provisioned_at']}")
    ds = st.get("database_server")
    if st.get("role") == "database-server":
        print("role:        database server (Phase 14: the estate's data; an office provisions against it)")
    ap = st.get("application_server")
    if st.get("role") == "application-server" and isinstance(ap, dict):
        print(f"role:        application server (the kernel is on another server: {ap.get('kernel') or 'no door set'})")
        apps = ", ".join(ap.get("installed") or []) or "none"
        print(f"applications: {apps}" + (f"; FAILED: {', '.join(ap.get('failed') or [])}" if ap.get("failed") else "")
              + (f"; {ap.get('error')}" if ap.get("error") else ""))
    print(f"database:    {st['database']}  (maludb_core {st.get('maludb_core')})"
          + (f"  this server's own names on the database server: suffix {st['platform_suffix']}" if st.get("platform_suffix") else ""))
    if st.get("role") == "database-server" and ds:
        print(f"serves:      {ds.get('listen')} port {ds.get('port')}, TLS {ds.get('tls')}, clients {', '.join(ds.get('clients') or []) or 'none'}")
        print(f"admin role:  {ds.get('admin')}  (not a superuser; `sudo maluctl db export DIR` writes its credential for an office's plan)")
        print(f"certificate: {ds.get('fingerprint')}")
    elif ds:
        print(f"data:        on the database server {ds.get('host')}:{ds.get('port')} ({ds.get('sslmode')}) as {ds.get('admin')}")
    if st.get("tenant"):
        print(f"tenant:      {st['tenant']}")
        print(f"principal:   {st['admin_principal']}")
    if os.geteuid() == 0 and st.get("tenant"):
        try:
            n = mp.psql(f"SET ROLE {mp.qi(st['tenant'])}; SET search_path TO {mp.qi(st['tenant'])}, maludb_core, public; "
                        f"SELECT count(*) FROM maludb_principal;", st["database"])
            print(f"principals:  {n}")
        except Exception as e:
            print(f"principals:  ? ({e})")
    if st.get("listener"):
        try:
            with urllib.request.urlopen(st["listener"] + "/healthz", timeout=3) as r:
                h = "ok" if r.status == 200 else f"http {r.status}"
        except Exception as e:
            h = f"down ({e.__class__.__name__})"
        print(f"listener:    {st['listener']}  {h}  (user {st.get('listener_user')})")
        print(f"token:       {'sudo maluctl token' if st.get('token_file') else 'none (unauthenticated)'}")
    print(f"operators:   {', '.join(st.get('operators') or []) or '-'}")
    for name, r in (st.get("components") or {}).items():
        if r is None: continue
        if "error" in r: print(f"component:   {name}  FAILED {r['error'][:80]}"); continue
        extra = f"  {r.get('url')}" if r.get("url") else ""
        print(f"component:   {name}  {'ok' if r.get('healthy', True) else 'unhealthy'}{extra}")
        apps = r.get("apps")
        if apps and (apps.get("installed") or apps.get("failed")):
            print(f"apps:        {', '.join(apps.get('installed') or []) or '-'}"
                  + (f"  FAILED {', '.join(apps['failed'])}" if apps.get("failed") else ""))
        if r.get("names"):
            print(f"names:       {' '.join(r['names'])}")
    en = st.get("enroll")
    if en:
        if en.get("ok"):
            print(f"enrolment:   {en.get('kind')} {en.get('url')}  ok  (as {en.get('name') or '-'}" + (f", owner {en['owner']}" if en.get("owner") else "") + ")")
        else:
            print(f"enrolment:   {en.get('kind')} {en.get('url')}  FAILED  {str(en.get('error') or '')[:100]}")
    return 0


def cmd_firstboot(args):
    if args[:1] in (["status"], []):
        return cmd_status(args[1:])
    print(__doc__); return 2


def cmd_token(args):
    need_root()
    if args[:1] == ["api"]:
        f = os.path.join(mp.SECRETS_DIR, "api.token")
        if not os.path.exists(f):
            print("no API token (maludb-api not installed or not provisioned)", file=sys.stderr); return 1
        print(open(f).read().strip()); return 0
    if args[:1] == ["rotate"]:
        token = secrets.token_hex(32)
        with open(os.open(mp.TOKEN_FILE, os.O_WRONLY | os.O_CREAT | os.O_TRUNC, 0o600), "w") as f:
            f.write(token + "\n")
        lines = mp.set_env(mp.read_env_file(mp.LISTENER_CONF), "BEARER_TOKEN", token)
        with open(os.open(mp.LISTENER_CONF, os.O_WRONLY | os.O_CREAT | os.O_TRUNC, 0o600), "w") as f:
            f.write("\n".join(lines) + "\n")
        subprocess.run(["systemctl", "restart", mp.LISTENER_UNIT], check=False)
        print(token); return 0
    if not os.path.exists(mp.TOKEN_FILE):
        print("no token (listener unauthenticated or not provisioned)", file=sys.stderr); return 1
    print(open(mp.TOKEN_FILE).read().strip()); return 0


def cmd_principal(args):
    need_root()
    st = state() or sys.exit("not provisioned")
    db, t = st["database"], st["tenant"]
    pre = f"SET ROLE {mp.qi(t)}; SET search_path TO {mp.qi(t)}, maludb_core, public; "
    if args[:1] == ["list"]:
        print(mp.psql(pre + "SELECT principal_ref || '  ' || principal_kind || '  ' || coalesce(display_name,'') || '  home=' || coalesce(home_scope,'') FROM maludb_principal ORDER BY 1;", db) or "(none)")
        return 0
    if args[:1] == ["add"] and len(args) >= 2:
        ref, kind, name, home = args[1], "agent", args[1], args[1]
        it = iter(args[2:])
        for a in it:
            if a == "--kind": kind = next(it)
            elif a == "--name": name = next(it)
            elif a == "--home": home = next(it)
        mp.ensure_principal(db, t, {"ref": ref, "kind": kind, "display_name": name, "home_scope": home})
        return 0
    print(__doc__); return 2


def cmd_db(args):
    """Phase 14: where the data is, and a way to it that needs no superuser outside the database server."""
    need_root()
    st = state() or {}
    cfg = mp.load_config()
    t = mp.database_target(cfg)
    db = st.get("database") or cfg["database"]
    sub = args[0] if args else "status"
    if sub == "status":
        if mp.is_database_server(cfg):
            ds = st.get("database_server") or {}
            print(f"role:      database server, cluster {ds.get('cluster') or '-'}, port {ds.get('port') or mp.cluster_port()}")
            print(f"admin:     {ds.get('admin') or '-'}  (credential {ds.get('credential') or '-'})")
            print(f"clients:   {', '.join(ds.get('clients') or []) or '-'}")
            print(f"tls:       {ds.get('tls') or '-'}  {ds.get('fingerprint') or ''}")
        elif t:
            print(f"data:      on the database server {t['host']}:{t['port']} ({t['sslmode']}) as {t['admin']}")
        else:
            print("data:      this host's own PostgreSQL cluster (the local superuser over the socket)")
        try:
            row = mp.psql("SELECT current_user || '|' || current_setting('is_superuser') || '|' || current_setting('server_version') || '|' || "
                          "coalesce((SELECT CASE WHEN ssl THEN version ELSE 'no TLS' END FROM pg_stat_ssl WHERE pid = pg_backend_pid()), 'socket')")
            user, sup, ver, tls = (row.split("|") + ["", "", "", ""])[:4]
            print(f"reached:   yes, as {user} ({'superuser' if sup == 'on' else 'not a superuser'}), PostgreSQL {ver}, {tls}")
            print("databases: " + (mp.psql("SELECT string_agg(datname, ', ' ORDER BY datname) FROM pg_database WHERE NOT datistemplate OR datname = " + mp.ql(mp.DB_TEMPLATE)) or "-"))
            return 0
        except Exception as e:
            print(f"reached:   NO: {str(e).splitlines()[0][:200]}"); return 1
    if sub == "psql":
        rest = args[1:]
        if rest and not rest[0].startswith("-"):
            db, rest = rest[0], rest[1:]
        if t:
            mp.prepare_remote(t)
            os.execvpe("psql", ["psql", "-d", mp.conninfo(t, db), *rest], {**os.environ, "PGPASSFILE": mp.DB_PGPASS})
        env = mp._local_env() or dict(os.environ)
        os.execvpe("runuser", ["runuser", "-u", "postgres", "--", "psql", "-d", db, *rest], env)
    if sub == "export" and len(args) == 2:
        if not mp.is_database_server(cfg) or not st.get("database_server"):
            print("maluctl db export: this host is not a provisioned database server (role: database-server)", file=sys.stderr); return 1
        ds, out = st["database_server"], args[1]
        os.makedirs(out, mode=0o700, exist_ok=True)
        import shutil, socket
        cred, ca = os.path.join(out, "db-admin.txt"), os.path.join(out, "db-ca.pem")
        with open(os.open(cred, os.O_WRONLY | os.O_CREAT | os.O_TRUNC, 0o600), "w") as f:
            f.write(open(ds["credential"]).read().strip() + "\n")
        shutil.copyfile(ds["certificate"], ca); os.chmod(ca, 0o644)
        host = socket.gethostname().split(".")[0]
        # the name the other servers connect to: one their own network resolves and this server's certificate carries.
        # Not the overlay name: the overlay's members are rows of the kernel's database, which is on this server
        # (docs/phase14-database-server.md, "Where it differs from the plan", 1; the owner's answer 2026-11-12: the LAN name)
        blk = cfg.get("database_server") if isinstance(cfg.get("database_server"), dict) else {}
        fqdn = socket.getfqdn()
        lan = next((str(n) for n in (blk.get("names") or []) if n), None) or (fqdn if "." in fqdn and not fqdn.startswith("localhost") else host)
        frag = os.path.join(out, "database-server.yaml")
        with open(frag, "w") as f:
            f.write("# for the office's /etc/maluos/firstboot.yaml (or its install plan): the paths are where the two\n"
                    "# files beside this one will be on the office at first boot (the plan's medium)\n"
                    "# host: a name the office resolves on its own network at first boot (LAN DNS or an /etc/hosts line there) and\n"
                    "# that this server's certificate carries; add others with database_server.names here. Not the overlay name.\n"
                    f"database_server:\n  host: {lan}\n  port: {ds.get('port')}\n  admin: {ds.get('admin')}\n"
                    "  credential: file:/PATH/TO/db-admin.txt\n  sslmode: verify-full\n  ca: file:/PATH/TO/db-ca.pem\n")
        if st.get("listener") and st.get("token_file") and os.path.exists(st["token_file"]):
            lcfg = cfg.get("listener") or {}
            ltok = os.path.join(out, "listener-token.txt")
            with open(os.open(ltok, os.O_WRONLY | os.O_CREAT | os.O_TRUNC, 0o600), "w") as f:
                f.write(open(st["token_file"]).read().strip() + "\n")
            reach = str(lcfg.get("host") or "127.0.0.1")
            with open(frag, "a") as f:
                f.write("# the engine's listener stays with the data: the office's agents reach it here" +
                        ("" if reach not in ("127.0.0.1", "localhost", "::1") else " (set listener.host on this server first: it listens on loopback only)") + "\n"
                        f"listener:\n  url: http://{lan}:{lcfg.get('port', 5329)}\n  token: file:/PATH/TO/listener-token.txt\n")
            print(f"{ltok}   the listener's bearer token")
        print(f"{cred}   the admin role's password (keep it off shared media once the office has booted)")
        print(f"{ca}     this server's certificate (public)  {ds.get('fingerprint')}")
        print(f"{frag}   the office's database_server block")
        return 0
    print(__doc__); return 2


def cmd_provision(args):
    need_root()
    return mp.provision(force="--force" in args)


PLUGIN_DIR = os.environ.get("MALUCTL_PLUGIN_DIR", "/usr/lib/maluos/maluctl.d")


def plugins():
    """name -> path for /usr/lib/maluos/maluctl.d/<name>.py; each defines main(args) -> int."""
    import glob
    return {os.path.basename(f)[:-3]: f for f in sorted(glob.glob(os.path.join(PLUGIN_DIR, "*.py")))}


def run_plugin(path, args):
    import importlib.util
    spec = importlib.util.spec_from_file_location("maluctl_plugin_" + os.path.basename(path)[:-3], path)
    mod = importlib.util.module_from_spec(spec); spec.loader.exec_module(mod)
    return mod.main(args)


if __name__ == "__main__":
    cmds = {"status": cmd_status, "token": cmd_token, "principal": cmd_principal, "provision": cmd_provision, "firstboot": cmd_firstboot, "db": cmd_db}
    ext = plugins()
    if len(sys.argv) < 2 or (sys.argv[1] not in cmds and sys.argv[1] not in ext):
        print(__doc__.rstrip())
        if ext:
            print("plugins: " + ", ".join(f"maluctl {n}" for n in ext))
        sys.exit(2)
    if sys.argv[1] in cmds:
        sys.exit(cmds[sys.argv[1]](sys.argv[2:]))
    sys.exit(run_plugin(ext[sys.argv[1]], sys.argv[2:]) or 0)
