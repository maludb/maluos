#!/bin/sh
set -e
NAME=apple-bce
VERSION=0.2.9+git20260624.c7448ca
case "$1" in
    remove|upgrade|deconfigure)
        if [ -x /usr/sbin/dkms ] && dkms status -m "$NAME" -v "$VERSION" 2>/dev/null | grep -q "$NAME"; then
            dkms remove -m "$NAME" -v "$VERSION" --all || true
        fi
        ;;
esac
#DEBHELPER#
exit 0
