# Firefox comes from Mozilla's repository. Ubuntu's own "firefox" package is
# a transitional deb (version 1:1snap1...) that installs snapd and the snap;
# its epoch would beat Mozilla's version numbers, so pin Mozilla's packages
# above everything and keep Ubuntu's firefox out of reach.
Package: *
Pin: origin packages.mozilla.org
Pin-Priority: 1000

Package: firefox
Pin: release o=Ubuntu
Pin-Priority: -1
