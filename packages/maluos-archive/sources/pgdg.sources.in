# PostgreSQL Global Development Group repository (PostgreSQL 18 for MaluOS).
# Installed by the maluos-archive package. Same file name as
# /usr/share/postgresql-common/pgdg/apt.postgresql.org.sh writes, so the two
# never coexist; if you ran that script before installing MaluOS, dpkg will
# ask about the conffile - accept the package version.
Types: deb
URIs: https://apt.postgresql.org/pub/repos/apt
Suites: @MALUOS_SUITE@-pgdg
Components: main
Signed-By: /usr/share/postgresql-common/pgdg/apt.postgresql.org.gpg
