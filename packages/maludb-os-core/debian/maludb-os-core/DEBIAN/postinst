#!/bin/sh
set -e
case "$1" in
    configure)
        for u in bos-runner bos-agent; do
            getent passwd $u >/dev/null || adduser --system --group --no-create-home --shell /usr/sbin/nologin $u
        done
        usermod -a -G bos-agent,adm,systemd-journal bos-runner
        install -d -o www-data -g www-data -m 750 /var/www/storage
        install -d -o bos-runner -g bos-agent -m 2770 /var/lib/business-os /var/lib/business-os/agents
        install -d -m 755 /etc/business-os /srv/apps
        install -d -o www-data -g www-data -m 755 /var/www/web/.next 2>/dev/null || true
        chown -R www-data:www-data /var/www/web/.next
        chmod 0440 /etc/sudoers.d/bos-runner && visudo -cf /etc/sudoers.d/bos-runner >/dev/null
        chmod 0755 /usr/sbin/bos-agent-exec
        # PHP limits for the Documents uploads, for whichever PHP Apache runs
        phpv=$(php -r 'echo PHP_MAJOR_VERSION.".".PHP_MINOR_VERSION;' 2>/dev/null || true)
        if [ -n "$phpv" ] && [ -d "/etc/php/$phpv/apache2/conf.d" ]; then
            install -m 644 /usr/share/maludb-os-core/php-99-business-os.ini "/etc/php/$phpv/apache2/conf.d/99-business-os.ini"
        fi
        # Apache: the localhost-only PHP API port and the modules the vhost needs
        grep -q '^Listen 127.0.0.1:8080' /etc/apache2/ports.conf || echo 'Listen 127.0.0.1:8080' >> /etc/apache2/ports.conf
        a2enmod -q proxy proxy_http rewrite headers >/dev/null 2>&1 || true
        ;;
esac
# Automatically added by dh_installsystemd/13.31ubuntu1
if [ "$1" = "configure" ] || [ "$1" = "abort-upgrade" ] || [ "$1" = "abort-deconfigure" ] || [ "$1" = "abort-remove" ] ; then
	if deb-systemd-helper debian-installed 'maludb-os-actions-mcp.service'; then
		# The following line should be removed in trixie or trixie+1
		deb-systemd-helper unmask 'maludb-os-actions-mcp.service' >/dev/null || true

		if deb-systemd-helper --quiet was-enabled 'maludb-os-actions-mcp.service'; then
			# Create new symlinks, if any.
			deb-systemd-helper enable 'maludb-os-actions-mcp.service' >/dev/null || true
		fi
	fi

	# Update the statefile to add new symlinks (if any), which need to be cleaned
	# up on purge. Also remove old symlinks.
	deb-systemd-helper update-state 'maludb-os-actions-mcp.service' >/dev/null || true
fi
# End automatically added section
# Automatically added by dh_installsystemd/13.31ubuntu1
if [ "$1" = "configure" ] || [ "$1" = "abort-upgrade" ] || [ "$1" = "abort-deconfigure" ] || [ "$1" = "abort-remove" ] ; then
	if deb-systemd-helper debian-installed 'maludb-os-activity-ingest.timer'; then
		# The following line should be removed in trixie or trixie+1
		deb-systemd-helper unmask 'maludb-os-activity-ingest.timer' >/dev/null || true

		if deb-systemd-helper --quiet was-enabled 'maludb-os-activity-ingest.timer'; then
			# Create new symlinks, if any.
			deb-systemd-helper enable 'maludb-os-activity-ingest.timer' >/dev/null || true
		fi
	fi

	# Update the statefile to add new symlinks (if any), which need to be cleaned
	# up on purge. Also remove old symlinks.
	deb-systemd-helper update-state 'maludb-os-activity-ingest.timer' >/dev/null || true
fi
# End automatically added section
# Automatically added by dh_installsystemd/13.31ubuntu1
if [ "$1" = "configure" ] || [ "$1" = "abort-upgrade" ] || [ "$1" = "abort-deconfigure" ] || [ "$1" = "abort-remove" ] ; then
	if deb-systemd-helper debian-installed 'maludb-os-activity-mcp.service'; then
		# The following line should be removed in trixie or trixie+1
		deb-systemd-helper unmask 'maludb-os-activity-mcp.service' >/dev/null || true

