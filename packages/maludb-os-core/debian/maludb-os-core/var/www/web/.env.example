# Copy to web/.env.local — owner www-data:www-data, mode 640 (the maludb-os-web service reads it).
# The process environment wins over this file: API_BASE_URL, OS_HOST and APP_HOST are set in the
# systemd drop-in (docs/deploy/maludb-os-web.service.d-cutover.conf), so only the two below matter here.

# The PHP JSON API, same box, no CORS (the server component forwards the visitor's cookie to it).
# Set by the drop-in as well; keep the two the same.
API_BASE_URL=http://127.0.0.1:8080

# Where a signed-out visitor is sent to log in: the PUBLIC sign-in URL a browser can reach.
# Never localhost — that would send the visitor to their own machine.
LOGIN_URL=https://app.example.com/login

# Same value as WEB_INTERNAL_KEY in config/.env — proves to PHP that a localhost call is this
# server, so the visitor address it forwards is believed (login lockout, activity log).
WEB_INTERNAL_KEY=
