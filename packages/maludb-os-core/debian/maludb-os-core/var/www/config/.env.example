# MaluDB OS kernel — environment config.
# Copy to /var/www/config/.env (owner: the deploy user, group www-data, mode 640) and fill in.
# NEVER commit the real .env. app/bootstrap.php, the MCP servers (mcp/db.py) and the bin/ tools
# load this file; a real environment variable (systemd, Apache SetEnv) wins over the file.
# Values are taken whole to the end of the line — no comment after a value, ever.
# The install runbook is docs/install.md; the keys below follow its order.

# --- The application --------------------------------------------------------------------------
# prod: session cookies are always Secure (the TLS proxy in front) and mail is only sent with a key.
# dev: a local http host; without a MaluMail key, mail is logged instead of sent.
APP_ENV=prod
# APP_DEBUG=1 shows PHP errors in the browser — leave 0 on any reachable site.
APP_DEBUG=0
APP_NAME="MaluDB OS"
# The public sign-in origin: links in mail, and the hint bin/bootstrap_organizer.php prints.
APP_URL=https://app.example.com

# --- The kernel's two faces (A2, docs/build-specs/kernel-hosts.md) -----------------------------
# Super-admins run the operating system at OS_HOST; everyone signs in and launches applications at
# APP_HOST. Both empty = one face. The same two values go into the maludb-os-web systemd drop-in
# (docs/deploy/maludb-os-web.service.d-cutover.conf).
OS_HOST=os.example.com
APP_HOST=app.example.com
# One login for both names (bootstrap.php applies it only when the request's host ends with it).
# Leave empty on localhost.
SESSION_COOKIE_DOMAIN=.example.com
# Browser origins allowed to call /api/v1/* directly (CORS); empty allows none.
API_CORS_ORIGINS=

# --- PostgreSQL (roles created by db/000 and db/097; passwords set by ALTER ROLE at install) ----
DB_HOST=127.0.0.1
DB_PORT=5432
DB_NAME=maludb_os
DB_USER=app_rw
DB_PASSWORD=
# The records MCP server and the actions MCP server read as app_records_ro; the activity MCP
# server as app_activity_ro. Both roles see only the mcp_* views.
MCP_RECORDS_DB_USER=app_records_ro
MCP_RECORDS_DB_PASSWORD=
MCP_ACTIVITY_DB_USER=app_activity_ro
MCP_ACTIVITY_DB_PASSWORD=

# --- Keys (generate each with: openssl rand -hex 32) --------------------------------------------
# Encrypts TOTP secrets at rest (libsodium). 64 hex chars = 32 bytes.
APP_TOTP_KEY=
# Signs action tokens and run tokens. The SAME value goes in /etc/business-os/runner.env.
ACTION_TOKEN_KEY=
# Tenant secrets (app/secrets.php, AES-256-GCM). 64 hex chars. NEVER replace it: a rotation ADDS
# SECRETS_KEY_V2 and sets SECRETS_KEY_VERSION=2; every older version stays readable.
SECRETS_KEY=
SECRETS_KEY_VERSION=1
# Proves to PHP that a localhost call is the Next.js server. The SAME value goes in web/.env.local.
WEB_INTERNAL_KEY=
# The agent runner's API key (X-Runner-Key). The SAME value goes in runner.env.
RUNNER_KEY=
RUNNER_URL=http://127.0.0.1:8815
# PHP and the actions MCP server share it; it is NEVER put in runner.env or handed to an agent.
ACTIONS_RELAY_KEY=

# --- MaluDB (activity memory; docs/install.md §2) ----------------------------------------------
MALUDB_API_URL=http://127.0.0.1:8000
# Minted with POST /v1/tokens by proving the memory role's login. The runner carries the same token.
MALUDB_API_TOKEN=
# The kernel's own memory database, schema and role (never the `maludb` bootstrap database).
# bin/app_install.php mints each application's memory token with these.
MALUDB_MEMORY_DB=maludb_os_memory
MALUDB_MEMORY_USER=maludb_os_mem
MALUDB_MEMORY_PASSWORD=

# --- MaluMail (transactional email: invitations, password resets, notifications) ---------------
MALUMAIL_API_KEY=
MAIL_FROM=no-reply@example.com
MAIL_FROM_NAME="MaluDB OS"

# --- Sign in with Google (server-side OIDC; optional) ------------------------------------------
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
GOOGLE_REDIRECT_URI=https://app.example.com/auth/google/callback

# --- Optional -----------------------------------------------------------------------------------
# Uploaded files. Empty = /var/www/storage (www-data, mode 750).
STORAGE_ROOT=
# The public URL Twilio posts a text to (its signature is checked against it; db/156):
# https://app.example.com/channels/twilio/sms
CHANNELS_TWILIO_SMS_URL=
# The voice provider's key (voice agents' inbound webhook).
RETELL_API_KEY=
