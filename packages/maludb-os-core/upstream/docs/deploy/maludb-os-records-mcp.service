[Unit]
Description=MaluDB OS — records MCP server (read-only, localhost:8811)
After=network.target postgresql.service
Wants=postgresql.service

[Service]
Type=simple
User=www-data
Group=www-data
WorkingDirectory=/var/www/mcp
ExecStart=/var/www/mcp/venv/bin/python /var/www/mcp/records_server.py
Restart=on-failure
RestartSec=5
# Hardening
NoNewPrivileges=true
PrivateTmp=true
ProtectSystem=full

[Install]
WantedBy=multi-user.target
