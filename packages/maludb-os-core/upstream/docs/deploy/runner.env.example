# /etc/business-os/runner.env — the agent runner's OWN settings. root:bos-runner 0640.
# The runner cannot read config/.env and the agent process (user bos-agent) can read neither file.
# Provider API keys live ONLY here: the ledger proxy adds them to a forwarded call, so no agent
# ever holds one. When tenant_secrets gains a writer they move there (model_registry.api_secret_id).

RUNNER_DB_USER=app_runner
RUNNER_DB_PASSWORD=            # ALTER ROLE app_runner PASSWORD '…'  (role created by db/097)
RUNNER_DB_NAME=maludb_os

ACTION_TOKEN_KEY=              # the SAME value as config/.env — run tokens are verified by mcp/db.py and app/auth.php
RUNNER_KEY=                    # the SAME value as config/.env — runner API callers and the completion callback
PROXY_KEY_SECRET=              # runner only: signs the per-run ledger-proxy keys.  openssl rand -hex 32

ANTHROPIC_API_KEY=              # the Installer and every agent on the Claude harness (docs/deploy/set-provider-key.sh for the others)
OPENROUTER_API_KEY=             # JEV — the eval grader (db/144) and the system_one agents (Auditor, Sysadmin)
# OPENAI_API_KEY=  DEEPSEEK_API_KEY=  MOONSHOT_API_KEY=  FIREWORKS_API_KEY=     (mcp/agent_runner/config.py PROVIDERS)

MALUDB_API_URL=http://127.0.0.1:8000
MALUDB_API_TOKEN=               # the SAME token as config/.env — the runner's memory (recall, core memory, transcripts)

RUNNER_SCHEDULER=on             # agents' scheduled duties fire; off = nothing scheduled runs (mcp/agent_runner/scheduler.py)

# Defaults, for reference:
# RUNNER_API_PORT=8815  RUNNER_PROXY_PORT=8816  RUNNER_MAX_WORKERS=2  RUNNER_DEFAULT_TIMEOUT=900
# RUNNER_AGENTS_DIR=/var/lib/business-os/agents
# config/.env additionally needs ACTIONS_RELAY_KEY (PHP + the actions MCP server; NEVER the runner) and RUNNER_KEY.
