# Secrets and environment
/config/.env
/.env

# Local Claude Code settings
/.claude/

# Composer dependencies (composer.lock IS committed to pin versions)
/vendor/

# Scratch
*.log

# Python venv + caches
/mcp/venv/
__pycache__/
*.egg-info/
*.pyc

# Uploaded files (tenant storage root; db/090)
/storage/

# Next.js front end (/var/www/web)
/web/node_modules/
/web/.next/
/web/out/
/web/.env.local

# Session transcripts and env backups (may hold pasted secrets)
claude-log/
/config/.env.bak*
*.env.bak*

# Application registries (mcp/registries/<app_key>.json) are written by bin/app_install.php for
# THIS installation — they carry its hosts and loopback ports. The README there stays tracked.
/mcp/registries/*.json
# ...and bin/actions_tool_names.php apply keeps copies of them here (K55).
/mcp/registries/backup-*/
