#!/usr/bin/make -f
%:
	dh $@

override_dh_auto_build:
	mkdir -p build
	for k in keys/*.asc; do gpg --batch --no-default-keyring --keyring ./build/tmp.kbx --import "$$k"; done
	gpg --batch --no-default-keyring --keyring ./build/tmp.kbx --export > build/maluos-archive-keyring.gpg
	test -s build/maluos-archive-keyring.gpg

override_dh_auto_clean:
	rm -rf build
