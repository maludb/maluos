# MaluDB API server (maludb-api.service). Read as the unit's environment.
MALUDB_API_HOST=127.0.0.1
MALUDB_API_PORT=8000
MALUDB_API_WORKERS=2
MALUDB_PG_HOST=localhost
MALUDB_PG_PORT=5432
MALUDB_AUTH_STORE=/var/lib/maludb-api/auth.db
MALUDB_LOG_DIR=/var/log/maludb-api
# Seals secrets (tenant passwords, provider keys) in the auth store at rest.
# MaluOS first boot generates one; leave empty to store them plain (dev only).
MALUDB_STORE_KEY=
