// MaluOS estate (Phase 13 slice 2): the estate daemon runs a system manager's remote actions, verified by their
// envelope and allowed by this node's own actions.allow — the agents' units, the updates unit, a reboot.
polkit.addRule(function(action, subject) {
    if (subject.user != "maluos-estate")
        return polkit.Result.NOT_HANDLED;
    if (action.id == "org.freedesktop.systemd1.manage-units") {
        var unit = action.lookup("unit") || "";
        var verb = action.lookup("verb") || "";
        if (/^maluos-agent@[a-z][a-z0-9-]*\.service$/.test(unit) && ["start", "stop", "restart", "reload-or-restart", "try-restart"].indexOf(verb) >= 0)
            return polkit.Result.YES;
        if (unit == "maluos-estate-updates.service" && verb == "start")
            return polkit.Result.YES;
    }
    if (action.id == "org.freedesktop.login1.reboot" || action.id == "org.freedesktop.login1.reboot-multiple-sessions")
        return polkit.Result.YES;
    return polkit.Result.NOT_HANDLED;
});
