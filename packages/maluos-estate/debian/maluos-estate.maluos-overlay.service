[Unit]
Description=MaluOS estate overlay: this host's tunnel on the estate's network and the names
Documentation=https://github.com/maludb/maluos
ConditionPathExists=|/etc/maluos/estate.yaml
ConditionPathExists=|/etc/maluos/office.yaml
After=network-online.target maluos-vault.socket
Wants=network-online.target

[Service]
Type=simple
WorkingDirectory=/usr/lib/maluos
Environment=PYTHONPATH=/usr/lib/maluos
Environment=PYTHONUNBUFFERED=1
ExecStart=/usr/bin/python3 -s -m maluos_estate.overlay
StateDirectory=maluos/estate
RuntimeDirectory=maluos/overlay
RuntimeDirectoryMode=1777
RuntimeDirectoryPreserve=yes
TimeoutStopSec=20
Restart=on-failure
RestartSec=5

# Root, for the interface and /etc/hosts; what it does not need is taken away.
CapabilityBoundingSet=CAP_NET_ADMIN CAP_DAC_OVERRIDE CAP_CHOWN CAP_FOWNER CAP_KILL
AmbientCapabilities=CAP_NET_ADMIN
NoNewPrivileges=yes
ProtectSystem=full
ReadWritePaths=/etc/hosts /var/lib/maluos/estate /run/maluos/overlay
ProtectHome=yes
PrivateTmp=yes
ProtectKernelLogs=yes
ProtectControlGroups=yes
ProtectClock=yes
RestrictAddressFamilies=AF_UNIX AF_INET AF_INET6 AF_NETLINK
RestrictNamespaces=yes
RestrictRealtime=yes
RestrictSUIDSGID=yes
LockPersonality=yes
SystemCallArchitectures=native

[Install]
WantedBy=multi-user.target
