#!/bin/sh
set -e
case "$1" in
    configure)
        if ! getent passwd maluos-estate >/dev/null; then
            adduser --system --group --no-create-home --home /var/lib/maluos/estate \
                    --shell /usr/sbin/nologin maluos-estate
        fi
        install -d -m 0755 /var/lib/maluos
        install -d -o maluos-estate -g maluos-estate -m 0755 /var/lib/maluos/estate
        ;;
esac
#DEBHELPER#
exit 0
